# Development screen recordings: 1.9 GB of .mov, every file over GitHub's 100 MB limit.
# The tracked record of what they are lives in docs/development-recordings.md.
recordings/
.worktrees/

# Circuit / intercept / glide-drone OFT run tapes (agent-facing). Keep analysis/*/README.md tracked.
analysis/circuit-oft/*/
analysis/intercept-oft/*/
analysis/glide-drone-oft/*/
analysis/perf/*
!analysis/perf/README.md

# Local scenery debug frames/probes. Keep README if present.
analysis/desktop-captures/scenery-flicker/*
!analysis/desktop-captures/scenery-flicker/README.md

# ADR-0003 AI mood refs: track index.json only; binaries stay local.
analysis/art-refs/**/*.png
analysis/art-refs/**/*.jpg
analysis/art-refs/**/*.jpeg
analysis/art-refs/**/*.webp
analysis/art-refs/**/*.gif

# Local Copernicus DEM cache (immutable objects; lock JSON is committed)
.cache/

# Ukraine geodetic atlas page bundles (~400 MiB); rebuild from locked Copernicus cache.
content/packs/ukraine-modern/environment/terrain-atlas/pages/
web/wwwroot/content/packs/ukraine-modern/environment/terrain-atlas/pages/

# Local jet-audio listen renders (regenerate via preview/wav_dump_server.mjs)
web/wwwroot/render/audio/preview/out/

# Local reference cockpit pulls for A/B (not redistributed)
web/wwwroot/render/audio/preview/ref/

# Local hybrid sample beds — allow committed CC0 loops; ignore raw extracts only.
web/wwwroot/render/audio/samples/jet/_*.wav
web/wwwroot/render/audio/samples/jet/_*.flac
web/wwwroot/render/audio/samples/jet/*.flac
!web/wwwroot/render/audio/samples/jet/SOURCES.md
!web/wwwroot/render/audio/samples/jet/idle_loop.wav
!web/wwwroot/render/audio/samples/jet/mil_loop.wav
!web/wwwroot/render/audio/samples/jet/grit_loop.wav

