<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Real player flight paths replayed by RealPlayerTrackTests. Regenerate with
         tools/telemetry/extract_bfm_fixtures.py (reads the local chunk cache, no network). -->
    <None Include="fixtures\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\sim\GunsOnly.Sim.csproj" />
    <Compile Include="..\web\IncidentReplayProjection.cs" Link="IncidentReplayProjection.cs" />
    <Compile Include="..\web\SnapshotJson.cs" Link="SnapshotJson.cs" />
    <Compile Include="..\web\CasevacSnapshotProjection.cs" Link="CasevacSnapshotProjection.cs" />
    <Compile Include="..\web\CobraAirframeSwapControlLatch.cs" Link="CobraAirframeSwapControlLatch.cs" />
    <Compile Include="..\web\SnapshotProjection.cs" Link="SnapshotProjection.cs" />
    <Compile Include="..\web\SnapshotHotFrame.cs" Link="SnapshotHotFrame.cs" />
    <Compile Include="..\web\MeshSnapshot.cs" Link="MeshSnapshot.cs" />
    <Compile Include="..\web\MedevacSnapshotProjection.cs" Link="MedevacSnapshotProjection.cs" />
    <Compile Include="..\web\MotorcycleSnapshotProjection.cs" Link="MotorcycleSnapshotProjection.cs" />
    <Compile Include="..\web\MedevacWebJsonContext.cs" Link="MedevacWebJsonContext.cs" />
    <Compile Include="..\web\KoreaTerrainTruth.cs" Link="KoreaTerrainTruth.cs" />
    <EmbeddedResource
      Include="..\content\packs\korea-1950s\environment\terrain\central-front.truth"
      Link="Data\central-front.truth"
      LogicalName="GunsOnly.Web.Data.KoreaCentralFront.truth" />
    <EmbeddedResource
      Include="..\content\packs\ukraine-modern\environment\terrain-atlas\rapier-site.kernel.truth"
      Link="Data\rapier-site.kernel.truth"
      LogicalName="GunsOnly.Web.Data.UkraineRapierSite.truth" />
    <EmbeddedResource
      Include="..\content\packs\ukraine-modern\environment\terrain-atlas\rapier-range.kernel.truth"
      Link="Data\rapier-range.kernel.truth"
      LogicalName="GunsOnly.Web.Data.UkraineRapierRange.truth" />
    <EmbeddedResource
      Include="..\content\packs\ukraine-modern\environment\terrain-atlas\rapier-range.atlas.manifest.json"
      Link="Data\rapier-range.atlas.manifest.json"
      LogicalName="GunsOnly.Web.Data.UkraineRapierRange.manifest.json" />
    <EmbeddedResource
      Include="..\content\packs\ukraine-modern\environment\terrain-atlas\rapier-range.kernel.provenance.json"
      Link="Data\rapier-range.kernel.provenance.json"
      LogicalName="GunsOnly.Web.Data.UkraineRapierRange.provenance.json" />
  </ItemGroup>

</Project>
