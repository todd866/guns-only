<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishTrimmed>true</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.29" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.29" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../sim/GunsOnly.Sim.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource
      Include="../content/packs/korea-1950s/environment/terrain/central-front.truth"
      Link="Data/central-front.truth"
      LogicalName="GunsOnly.Web.Data.KoreaCentralFront.truth"
      Condition="'$(EmbedKoreaTerrainTruth)' != 'false'" />
    <EmbeddedResource
      Include="../content/packs/ukraine-modern/environment/terrain-atlas/rapier-site.kernel.truth"
      Link="Data/rapier-site.kernel.truth"
      LogicalName="GunsOnly.Web.Data.UkraineRapierSite.truth"
      Condition="'$(EmbedUkraineTerrainTruth)' != 'false'" />
    <EmbeddedResource
      Include="../content/packs/ukraine-modern/environment/terrain-atlas/rapier-range.kernel.truth"
      Link="Data/rapier-range.kernel.truth"
      LogicalName="GunsOnly.Web.Data.UkraineRapierRange.truth"
      Condition="'$(EmbedUkraineTerrainTruth)' != 'false'" />
  </ItemGroup>
  <ItemGroup>
    <!-- Keep source-only QA and the unused Blazor-template Bootstrap tree out of the static
         deployment. Vercel treats every published api/*.js file as a function, and shipping the
         renderer's Node tests plus 8 MB of unreferenced template assets only adds deploy/transfer
         surface. -->
    <Content Update="wwwroot/api/*.test.js" CopyToPublishDirectory="Never" />
    <Content Update="wwwroot/**/*.test.js" CopyToPublishDirectory="Never" />
    <Content Update="wwwroot/**/*.test.mjs" CopyToPublishDirectory="Never" />
    <Content Update="wwwroot/render/**/tests/**" CopyToPublishDirectory="Never" />
    <!-- The audio preview is workstation-only authoring tooling. Its gitignored ref/ and out/
         directories can contain large third-party comparison recordings and local listen renders;
         Git cleanliness therefore cannot prove they are absent. Exclude the whole lab at the
         publish boundary so no local QA artifact can become a public static asset. -->
    <Content Update="wwwroot/render/audio/preview/**/*" CopyToPublishDirectory="Never" />
    <!-- Raw hybrid extracts are also gitignored and can exist in an otherwise clean worktree.
         Apply the fail-closed rule to every aircraft-family subtree; only explicitly reviewed,
         named production WAV loops may cross the publish boundary. -->
    <Content Update="wwwroot/render/audio/samples/**/_*.wav" CopyToPublishDirectory="Never" />
    <Content Update="wwwroot/render/audio/samples/**/_*.flac" CopyToPublishDirectory="Never" />
    <Content Update="wwwroot/render/audio/samples/**/*.flac" CopyToPublishDirectory="Never" />
    <!-- Standalone authoring/review labs remain available from the development host, but they are
         not experiences in the executable release catalog and have no production route gate.
         Exclude their entrypoints and local review assets from the public artifact. Cobra Lab is
         intentionally absent from this list: it is catalogued, quarantined, and fail-closed. -->
    <Content Update="wwwroot/asset-lab/**/*" CopyToPublishDirectory="Never" />
    <Content Update="wwwroot/effects-lab/**/*" CopyToPublishDirectory="Never" />
    <Content Update="wwwroot/environment-lab/**/*" CopyToPublishDirectory="Never" />
    <Content Update="wwwroot/present/rapier-design/**/*" CopyToPublishDirectory="Never" />
    <Content Update="wwwroot/lib/**" CopyToPublishDirectory="Never" />
  </ItemGroup>
</Project>
