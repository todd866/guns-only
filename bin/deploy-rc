#!/bin/sh
# Ship Saucer Springs AFB on its own: RC tests -> package -> headless boot smoke of the package -> deploy to
# the guns-only-rc Vercel project -> smoke the live site. About 5 minutes. guns-only.com/rc/ is a
# rewrite to this project (web/wwwroot/vercel.json), so the main site picks it up with no deploy.
# The main pipeline (bin/check, CI, the F-22 frame gate) never sees RC changes and keeps its full
# strictness for the flight game.
#   bin/deploy-rc            production
#   bin/deploy-rc --preview  a preview URL only
set -eu
repo=$(cd "$(dirname "$0")/.." && pwd); cd "$repo"
run_job() {
  if [ -f "$HOME/.codex/power/battery_guard.py" ]; then
    /usr/bin/python3 "$HOME/.codex/power/battery_guard.py" run -- "$@"
  else
    "$@"
  fi
}
dist="$repo/.rc-dist"; target=--prod; [ "${1:-}" = "--preview" ] && target=""
tmp=$(mktemp -d "${TMPDIR:-/tmp}/guns-only-rc-deploy.XXXXXX")
trap 'rm -rf "$tmp"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
evidence="$repo/evidence/rc-open-world/deploy-$(date -u +%Y%m%dT%H%M%SZ)"
mkdir -p "$evidence"
echo "deploy-rc: unit tests"
(cd web/wwwroot/rc && run_job node --test --test-concurrency=2) >"$evidence/unit-tests.txt" 2>&1 || { cat "$evidence/unit-tests.txt"; exit 1; }
run_job node --test --test-concurrency=2 tools/rc/*.test.mjs tools/rc/harness/*.test.mjs >"$evidence/tool-tests.txt" 2>&1 || { cat "$evidence/tool-tests.txt"; exit 1; }
echo "deploy-rc: asset manifest (licence, provenance, budgets, completeness)"
run_job node tools/rc/asset-manifest.mjs check
echo "deploy-rc: package"
node tools/rc/package-rc.mjs --bundle --out "$dist"
if [ ! -d web/smoke/node_modules/playwright ]; then (cd web/smoke && npm ci --ignore-scripts --no-audit --no-fund --silent && ./node_modules/.bin/playwright install chromium >/dev/null); fi
echo "deploy-rc: headless smoke of the package"
HEAVY_SLOT_LABEL=guns-only-rc-smoke run_job heavy-slot -- node tools/rc/smoke-dist.mjs "$dist"
echo "deploy-rc: hardware release gate of the package"
HEAVY_SLOT_LABEL=guns-only-rc-release run_job heavy-slot -- env RC_QA_ROOT="$dist" node tools/rc/check-release.cjs "$evidence/local-release"
echo "deploy-rc: phone control journey in the package"
HEAVY_SLOT_LABEL=guns-only-rc-mobile run_job heavy-slot -- env RC_QA_ROOT="$dist" node tools/rc/check-mobile.cjs "$evidence/local-mobile"
echo "deploy-rc: fresh-player journey in the package"
HEAVY_SLOT_LABEL=guns-only-rc-new-player run_job heavy-slot -- env RC_QA_ROOT="$dist" node tools/rc/check-new-player.cjs "$evidence/local-new-player"
echo "deploy-rc: deploy"
vercel link --yes --project guns-only-rc --scope ian-todds-projects --cwd "$dist" >/dev/null 2>&1
deploy_stdout="$tmp/vercel-deploy.stdout"
if ! run_job vercel deploy $target --yes --scope ian-todds-projects --cwd "$dist" >"$deploy_stdout"; then
  echo "deploy-rc: vercel deploy failed" >&2
  cat "$deploy_stdout" >&2
  exit 1
fi
url=$(grep -oE 'https://[a-z0-9.-]+\.vercel\.app' "$deploy_stdout" | tail -1)
[ -n "$url" ] || { echo "deploy-rc: vercel deploy returned no deployment URL" >&2; cat "$deploy_stdout" >&2; exit 1; }
echo "deploy-rc: deployed $url"
live=${url}; [ -n "$target" ] && live=https://guns-only-rc.vercel.app
if [ -n "$target" ]; then
  echo "deploy-rc: verify production alias bytes ($live)"
  node tools/rc/verify-dist.mjs "$dist" "$live"
else
  echo "deploy-rc: verify candidate bytes ($url)"
  node tools/rc/verify-dist.mjs "$dist" "$url"
fi
echo "deploy-rc: smoke the live site ($live)"
HEAVY_SLOT_LABEL=guns-only-rc-smoke run_job heavy-slot -- node tools/rc/smoke-dist.mjs "$dist" "$live"
echo "deploy-rc: hardware release gate of live site"
HEAVY_SLOT_LABEL=guns-only-rc-release run_job heavy-slot -- node tools/rc/check-release.cjs "$evidence/live-release" "$live"
echo "deploy-rc: phone control journey on the live site"
HEAVY_SLOT_LABEL=guns-only-rc-mobile run_job heavy-slot -- node tools/rc/check-mobile.cjs "$evidence/live-mobile" "$live"
if [ -n "$target" ]; then
  curl -fsS -o /dev/null -w "deploy-rc: guns-only.com/rc/ %{http_code}\n" https://guns-only.com/rc/
fi
# Ledger: docs/STATUS.md carries one "RC live" line naming the exact revision and deployment that
# serve guns-only.com/rc, written by the deploy itself (audit 3.1: the ledger drifted by branch).
# The deploying agent commits docs/STATUS.md with its release notes.
if [ -n "$target" ] && [ -f docs/STATUS.md ] && rev=$(git rev-parse HEAD 2>/dev/null); then
  stamp=$(date -u +%Y-%m-%dT%H:%MZ)
  line="RC live (guns-only.com/rc): revision \`$rev\` from branch $(git rev-parse --abbrev-ref HEAD), deployed $stamp as $url."
  if grep -q '^RC live (guns-only.com/rc):' docs/STATUS.md; then
    awk -v l="$line" '/^RC live \(guns-only.com\/rc\):/{print l; next} {print}' docs/STATUS.md > "$tmp/STATUS.md" && cp "$tmp/STATUS.md" docs/STATUS.md
  else
    awk -v l="$line" 'done!=1 && /^Production:/{print; print l; done=1; next} {print}' docs/STATUS.md > "$tmp/STATUS.md" && cp "$tmp/STATUS.md" docs/STATUS.md
  fi
  echo "deploy-rc: docs/STATUS.md RC live line updated (commit it with the release notes)"
fi
