#!/bin/sh
set -eu

repo_dir=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
cd "$repo_dir"
. "$repo_dir/bin/dotnet-env"

# CI and the checked-in release contract use Node 24. Refuse a different local major instead of
# producing a green gate whose loader, test-runner, and ESM behavior do not match the release job.
command -v node >/dev/null 2>&1 || {
    echo "check: Node.js 24 is required but node is unavailable" >&2
    exit 1
}
node_major=$(node -p 'process.versions.node.split(".")[0]' 2>/dev/null || true)
if [ "$node_major" != "24" ]; then
    echo "check: Node.js 24 is required; found $(node --version 2>/dev/null || echo unknown)" >&2
    exit 1
fi

# Serialize whole-repo gates across agents. Several agents share this workstation; parallel
# gates (dotnet suites + six SwiftShader Chromiums each) starve one another's browser smoke
# into false timeouts (2026-07-29: five deploy gates died at load average 70-85). One gate at
# a time, queued quietly; a lock whose holder has exited is reclaimed.
gate_lock="/tmp/guns-only-gate.lock"
gate_lock_announced=""
while ! mkdir "$gate_lock" 2>/dev/null; do
    holder=$(cat "$gate_lock/pid" 2>/dev/null || true)
    if [ -n "$holder" ] && ! kill -0 "$holder" 2>/dev/null; then
        rm -rf "$gate_lock"
        continue
    fi
    if [ -z "$gate_lock_announced" ]; then
        echo "check: waiting for the gate lock (held by pid ${holder:-unknown})"
        gate_lock_announced=1
    fi
    sleep 15
done
printf '%s' "$$" > "$gate_lock/pid"
trap 'rm -rf "$gate_lock"' EXIT HUP INT TERM

sh -n bin/dotnet-env
sh -n bin/test-in-process
sh -n bin/deploy-web
sh -n bin/stamp-release
node --check web/wwwroot/app.js
node --check web/wwwroot/hud.js
node --check web/wwwroot/multiplayer-config.js
node --check web/wwwroot/indoor/audio.js
node --check web/wwwroot/indoor/game.js
node --check web/wwwroot/indoor/presentation.js
node --check web/wwwroot/indoor/sim.js
node --check web/wwwroot/medevac/app.js
node --check web/wwwroot/render/medevac/commander_view_model.js
node --check web/wwwroot/api/telemetry.js
node --check web/smoke/remote-smoke.mjs
node --check web/smoke/remote-route-smoke.mjs
release_tests=$(find tools/release/tests -type f -name '*.test.mjs' -print | sort)
node --test $release_tests
./bin/stamp-release --check
node tools/assets/validate-manifests.mjs --strict
node tools/content/validate-governance.mjs --strict
asset_tests=$(find tools/assets -type f -name '*.test.mjs' -print | sort)
node --test $asset_tests
content_tests=$(find tools/content -type f -name '*.test.mjs' -print | sort)
node --test $content_tests
node --test tools/telemetry/test/*.test.mjs
node --test tools/perf/*.test.mjs
# Authored narrative sequences are a content contract with a schema and a validator; run it here
# or the contract only holds for as long as someone remembers to run it by hand.
narrative_tests=$(find docs/art-direction -type f -name '*.test.mjs' -print | sort)
if [ -n "$narrative_tests" ]; then
  node --test $narrative_tests
fi
python3 tools/audio/cockpit_palette.py self-test
python3 -m unittest discover -s tools/audio -p 'test_*.py'
python3 tools/terrain/test_hydrate_rapier_atlas.py
node --test tools/audio/*.test.mjs
# Format/unit smoke only — the live scenario matrix (--self-test) is still hardening.
node --test tools/anca-audit/*.test.mjs
runtime_tests=$(find web/wwwroot/render -type f -path '*/tests/*.test.mjs' -print | sort)
node --test $runtime_tests
node --test web/wwwroot/*.test.js
node --test web/wwwroot/api/*.test.js
node --test world-worker/tests/*.test.mjs

scratch_dir=$(mktemp -d)
publish_dir="$scratch_dir/publish"
staged_content_dir="$scratch_dir/content"
dotnet_artifacts_dir="$scratch_dir/dotnet-artifacts"
trap 'rm -rf "$scratch_dir" "$gate_lock"' EXIT HUP INT TERM

node tools/assets/build-assets.mjs stage \
  --pack content/packs/korea-1950s/pack.json \
  --output "$staged_content_dir"
# The Soniachne slice is terrain-only until the first authoritative Ukraine feature/vehicle pack
# exists. Stage its four generated runtime products explicitly so source and wwwroot cannot drift
# while avoiding a fake asset/presentation manifest around ambient procedural scenery.
ukraine_source_dir="content/packs/ukraine-modern/environment/terrain"
ukraine_stage_dir="$staged_content_dir/packs/ukraine-modern/environment/terrain"
mkdir -p "$ukraine_stage_dir"
cp "$ukraine_source_dir/soniachne-steppe.manifest.json" "$ukraine_stage_dir/"
cp "$ukraine_source_dir/soniachne-steppe.terrain" "$ukraine_stage_dir/"
cp "$ukraine_source_dir/soniachne-steppe.truth" "$ukraine_stage_dir/"
cp "$ukraine_source_dir/soniachne-steppe-preview.png" "$ukraine_stage_dir/"
# The 262 km regional corridor. It is embedded in the WASM payload as
# GunsOnly.Web.Data.UkraineSoniachneRegion.truth (web/GunsOnly.Web.csproj) and shipped under
# wwwroot alongside the hero cell, so it has to be staged too or this diff reports it as drift.
cp "$ukraine_source_dir/soniachne-region.truth" "$ukraine_stage_dir/"
cp "$ukraine_source_dir/soniachne-theatre-preview.png" "$ukraine_stage_dir/"
# Soft-world atmosphere (ADR-0003) for Ukraine lab / presentation wiring.
ukraine_env_dir="content/packs/ukraine-modern/environment"
ukraine_env_stage="$staged_content_dir/packs/ukraine-modern/environment"
mkdir -p "$ukraine_env_stage"
if [ -f "$ukraine_env_dir/atmosphere.material.json" ]; then
  cp "$ukraine_env_dir/atmosphere.material.json" "$ukraine_env_stage/"
fi
# Painterly presentation textures are authored source assets just like the atmosphere material.
# Stage the complete family so generated art cannot exist only in wwwroot or disappear at publish.
ukraine_texture_source="$ukraine_env_dir/textures"
ukraine_texture_stage="$ukraine_env_stage/textures"
if [ -d "$ukraine_texture_source" ]; then
  mkdir -p "$ukraine_texture_stage"
  cp -R "$ukraine_texture_source/." "$ukraine_texture_stage/"
fi
# Free-fly Mesh place catalog (authored destinations / landmarks for Open Segment).
ukraine_mesh_source="content/packs/ukraine-modern/environment/mesh"
ukraine_mesh_stage="$staged_content_dir/packs/ukraine-modern/environment/mesh"
if [ -d "$ukraine_mesh_source" ]; then
  mkdir -p "$ukraine_mesh_stage"
  cp -R "$ukraine_mesh_source/." "$ukraine_mesh_stage/"
fi
# The quarantined Cobra lab still has authoritative source content. Stage it through the same
# source-to-wwwroot truth check without promoting or routing the experience.
cobra_source="content/packs/cobra-vietnam"
cobra_stage="$staged_content_dir/packs/cobra-vietnam"
test -f "$cobra_source/environment/cobra-canyon.world.json"
mkdir -p "$cobra_stage"
cp -R "$cobra_source/." "$cobra_stage/"
# Rapier-range atlas (eastern corridor). Source of truth under content/; wwwroot is a staged copy.
ukraine_atlas_source="content/packs/ukraine-modern/environment/terrain-atlas"
ukraine_atlas_stage="$staged_content_dir/packs/ukraine-modern/environment/terrain-atlas"
python3 tools/terrain/hydrate_rapier_atlas.py verify --atlas-dir "$ukraine_atlas_source"
mkdir -p "$ukraine_atlas_stage"
cp -R "$ukraine_atlas_source/." "$ukraine_atlas_stage/"
# Hero-cell mission feature packs (authored scenery). Source of truth under content/; wwwroot is
# a staged copy.
ukraine_hero_source="content/packs/ukraine-modern/environment/hero-cells"
ukraine_hero_stage="$staged_content_dir/packs/ukraine-modern/environment/hero-cells"
if [ -d "$ukraine_hero_source" ]; then
  mkdir -p "$ukraine_hero_stage"
  cp -R "$ukraine_hero_source/." "$ukraine_hero_stage/"
fi
diff -qr "$staged_content_dir" web/wwwroot/content

"$dotnet_cli" restore GunsOnly.sln --nologo --ignore-failed-sources \
  --artifacts-path "$dotnet_artifacts_dir" -m:1 /nodeReuse:false
"$dotnet_cli" build GunsOnly.sln --configuration Release --no-restore --nologo \
  --artifacts-path "$dotnet_artifacts_dir" -m:1 /nodeReuse:false
if [ "${GUNS_TEST_IN_PROCESS:-0}" = "1" ]; then
  # VSTest opens a loopback control socket even for a local test assembly. Restricted release
  # hosts can forbid that bind while still allowing the tests themselves. The repository's
  # xUnit runner executes the same freshly built Release assemblies in process and fails on the
  # same test failures without asking for network authority.
  GUNS_TEST_CONFIGURATION=Release "$repo_dir/bin/test-in-process"
  GUNS_TEST_CONFIGURATION=Release "$repo_dir/bin/test-in-process" --server
else
  GUNS_REPO_ROOT="$repo_dir" "$dotnet_cli" test sim.Tests/GunsOnly.Sim.Tests.csproj \
    --configuration Release --no-build --nologo \
    --artifacts-path "$dotnet_artifacts_dir" -m:1 /nodeReuse:false
  GUNS_REPO_ROOT="$repo_dir" "$dotnet_cli" test server.Tests/GunsOnly.Server.Tests.csproj \
    --configuration Release --no-build --nologo \
    --artifacts-path "$dotnet_artifacts_dir" -m:1 /nodeReuse:false
fi

"$dotnet_cli" publish web/GunsOnly.Web.csproj \
  --configuration Release --no-restore --nologo --output "$publish_dir" \
  --artifacts-path "$dotnet_artifacts_dir" -m:1 /nodeReuse:false

test -f "$publish_dir/wwwroot/index.html"
test -f "$publish_dir/wwwroot/indoor/index.html"
test -f "$publish_dir/wwwroot/indoor/game.js"
test -f "$publish_dir/wwwroot/indoor/sim.js"
test -f "$publish_dir/wwwroot/medevac/index.html"
test -f "$publish_dir/wwwroot/medevac/app.js"
test -f "$publish_dir/wwwroot/medevac/styles.css"
test -f "$publish_dir/wwwroot/render/medevac/commander_view_model.js"
test -f "$publish_dir/wwwroot/_framework/blazor.webassembly.js"
test -f "$publish_dir/wwwroot/content/packs/korea-1950s/pack.json"
test -f "$publish_dir/wwwroot/content/packs/ukraine-modern/environment/terrain/soniachne-steppe.manifest.json"
test -f "$publish_dir/wwwroot/content/packs/ukraine-modern/environment/terrain/soniachne-steppe.terrain"
test -f "$publish_dir/wwwroot/content/packs/cobra-vietnam/environment/cobra-canyon.world.json"
python3 tools/terrain/hydrate_rapier_atlas.py verify \
  --atlas-dir "$publish_dir/wwwroot/content/packs/ukraine-modern/environment/terrain-atlas"
test -f "$publish_dir/wwwroot/render/assets/asset_registry.js"
test -f "$publish_dir/wwwroot/render/presence/global_room_client.js"
test -f "$publish_dir/wwwroot/multiplayer-config.js"
test -f "$publish_dir/wwwroot/api/telemetry.js"
test -f "$publish_dir/wwwroot/api/build-info.js"
test -f "$publish_dir/wwwroot/api/telemetry-admin.js"
test -z "$(find "$publish_dir/wwwroot" -type f \( -name '*.test.js' -o -name '*.test.mjs' \) -print -quit)"
test ! -d "$publish_dir/wwwroot/render/presence/tests"
test ! -d "$publish_dir/wwwroot/render/telemetry/tests"
test ! -d "$publish_dir/wwwroot/render/hud/tests"
test ! -e "$publish_dir/wwwroot/render/audio/preview"
test ! -e "$publish_dir/wwwroot/asset-lab"
test ! -e "$publish_dir/wwwroot/effects-lab"
test ! -e "$publish_dir/wwwroot/environment-lab"
test ! -e "$publish_dir/wwwroot/present/rapier-design"
test -f "$publish_dir/wwwroot/cobra-lab/index.html"
test -f "$publish_dir/wwwroot/cobra-lab/main.js"
test -f "$publish_dir/wwwroot/cobra-lab/styles.css"
test -f "$publish_dir/wwwroot/render/audio/samples/jet/f22_idle_loop.wav"
test -f "$publish_dir/wwwroot/render/audio/samples/jet/rapier_idle_cockpit_loop.wav"
test -z "$(find "$publish_dir/wwwroot/render/audio/samples/jet" -type f \
  \( -name '_*.wav' -o -name '_*.flac' -o -name '*.flac' \) -print -quit)"
test -f "$publish_dir/wwwroot/render/audio/samples/radio/manifest.json"
test ! -d "$publish_dir/wwwroot/lib/bootstrap"
test -f "$publish_dir/wwwroot/vercel.json"
grep -Fq '"source": "/telemetry-admin"' "$publish_dir/wwwroot/vercel.json"

# Browser smoke test: boot the published app in headless Chromium and require it reaches a running
# flight kernel (the #boot screen settles without the #fatal "FLIGHT KERNEL OFFLINE" modal). This is
# the only gate that executes app.js's real render path, so it catches boot regressions -- e.g. a
# deleted render helper that leaves syntax valid but breaks new FlightView() -- that every Node and
# .NET suite passes green. Set GUNS_SKIP_SMOKE=1 to skip it for a quick offline run.
if [ -z "${GUNS_SKIP_SMOKE:-}" ]; then
  (cd web/smoke && npm ci --ignore-scripts --no-audit --no-fund --silent)
  if [ -n "${CI:-}" ]; then
    (cd web/smoke && ./node_modules/.bin/playwright install --with-deps chromium webkit)
  else
    (cd web/smoke && ./node_modules/.bin/playwright install chromium webkit)
  fi
  SMOKE_WWWROOT="$publish_dir/wwwroot" node --test web/smoke/smoke.test.mjs
  # HUD geometry contract: numeric assertions through the real hud.js in headless Chromium
  # (waterline/FPV alpha gap, ladder tan-projection spacing, funnel-on-trajectory, bandit
  # marker). Lives with the browser gates because it shares the web/smoke Playwright install.
  node web/wwwroot/render/hud/tests/harness/assertions.mjs
else
  echo "Skipping browser smoke test (GUNS_SKIP_SMOKE set)."
fi

test -f world-worker/src/index.js
test -f world-worker/src/world.js
test -f world-worker/wrangler.jsonc

echo "Guns Only checks passed"
