diff --git a/web/wwwroot/rc/chase-camera.mjs b/web/wwwroot/rc/chase-camera.mjs
new file mode 100644
index 00000000..c035fa96
--- /dev/null
+++ b/web/wwwroot/rc/chase-camera.mjs
@@ -0,0 +1,42 @@
+// Chase camera vs walls. The old pull stopped ~5 cm short of a close face, inside
+// the near clip, so the wall texture filled the picture. Back up, and if the
+// face is too close to back away from, lift the eye off it.
+
+const hypot = (x, y, z) => Math.hypot(x, y, z);
+
+/**
+ * @param {number[]} eye car eye
+ * @param {number[]} want desired camera position
+ * @param {(origin:number[], dir:number[], max:number) => {dist:number}|null} raycast
+ * @returns {number[]}
+ */
+export function pullChaseCamera(eye, want, raycast, {gap = 0.45, lift = 0.7} = {}) {
+  const dx = want[0] - eye[0],
+    dy = want[1] - eye[1],
+    dz = want[2] - eye[2],
+    dist = hypot(dx, dy, dz);
+  if (!(dist > 1e-4) || typeof raycast !== 'function') return [want[0], want[1], want[2]];
+  const dir = [dx / dist, dy / dist, dz / dist];
+  const hit = raycast(eye, dir, dist);
+  let x = want[0],
+    y = want[1],
+    z = want[2];
+  if (hit && hit.dist > 0 && hit.dist < dist) {
+    const along = Math.min(dist, Math.max(0.05, hit.dist - gap));
+    x = eye[0] + dir[0] * along;
+    y = eye[1] + dir[1] * along;
+    z = eye[2] + dir[2] * along;
+    if (hit.dist - along < gap) y += lift;
+  }
+  // One-sided faces miss once the camera has crossed them. A ray back toward
+  // the car that hits immediately means the lens is in the surface: step toward
+  // the car and up.
+  const back = raycast([x, y, z], [-dir[0], -dir[1], -dir[2]], gap);
+  if (back && back.dist < gap * 0.85) {
+    const push = gap - back.dist;
+    x -= dir[0] * push;
+    y += lift - dir[1] * push;
+    z -= dir[2] * push;
+  }
+  return [x, y, z];
+}
diff --git a/web/wwwroot/rc/chase-camera.test.mjs b/web/wwwroot/rc/chase-camera.test.mjs
new file mode 100644
