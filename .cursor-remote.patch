+// Anticipation, impact, recovery. t is 0..1 across a strike shorter than 300 ms.
+function fightPose(g, arms, legs, mv) {
+  const t = mv.poseT || 0,
+    wind = t < 0.28 ? t / 0.28 : 0,
+    hit = t < 0.28 ? 0 : t < 0.55 ? (t - 0.28) / 0.27 : 1,
+    recover = t < 0.55 ? 0 : (t - 0.55) / 0.45,
+    s = hit * (1 - recover) - wind * 0.45;
+  if (mv.pose === 'jab') arms[1].rotation.x = -1.7 * s;
+  else if (mv.pose === 'jab2') arms[0].rotation.x = -1.7 * s;
+  else if (mv.pose === 'swing') {
+    arms[0].rotation.x = -1.1 * s;
+    arms[1].rotation.x = -1.1 * s;
+    arms[0].rotation.z = 0.8 * s;
+    arms[1].rotation.z = -0.8 * s;
+  } else if (mv.pose === 'upper') {
+    arms[0].rotation.x = -2.2 * Math.max(0, s);
+    arms[1].rotation.x = -2.2 * Math.max(0, s);
+  } else if (mv.pose === 'spin') {
+    legs[0].rotation.x = 1.1 * s;
+    legs[1].rotation.x = -1.1 * s;
+    g.rotation.y += s * Math.PI * 2;
+  } else if (mv.pose === 'pound') {
+    arms[0].rotation.x = 1.4 * Math.max(0.2, s + 0.4);
+    arms[1].rotation.x = 1.4 * Math.max(0.2, s + 0.4);
+  } else if (mv.pose === 'shield') {
+    arms[0].rotation.x = -1.2;
+    arms[1].rotation.x = -1.2;
+    arms[0].rotation.z = 0.5;
+    arms[1].rotation.z = -0.5;
+  } else if (mv.pose === 'dash') g.rotation.x = 0.45 * (1 - t);
+  else if (mv.pose === 'fly') {
+    g.rotation.x = 0.3;
+    arms[0].rotation.x = 0.6;
+    arms[1].rotation.x = 0.6;
+  }
+}
