+    const lamp = new T.Mesh(new T.SphereGeometry(0.16, 8, 8), lampMat.clone());
+    lamp.position.set(Math.sin(a) * (ARENA.outer - 0.4), 4.6 + (i % 2) * 0.35, Math.cos(a) * (ARENA.outer - 0.4));
+    root.add(lamp);
+    lamps.push(lamp);
+  }
+
+  const bodies = new Map();
+  const scraps = [];
+  const sparks = [];
+  for (let i = 0; i < 24; i++) {
+    const s = new T.Mesh(
+      new T.SphereGeometry(0.05, 6, 6),
+      new T.MeshBasicMaterial({color: '#ffe08a'})
+    );
+    s.visible = false;
+    root.add(s);
+    sparks.push(s);
+  }
+  let state = null;
+
+  function bodyFor(f) {
+    let g = bodies.get(f.id);
+    if (!g) {
+      g = makeRobotBody(f.color);
+      g.scale.setScalar(1.65);
+      root.add(g);
+      bodies.set(f.id, g);
+    }
+    g.userData.materials?.[0]?.color.set(f.color);
+    return g;
+  }
+
+  function pose(st) {
+    const live = new Set(st?.fighters?.map(f => f.id) ?? []);
+    for (const [id, g] of bodies) {
+      if (!live.has(id)) {
+        disposeRobotBody(g);
+        bodies.delete(id);
+      }
+    }
+    for (const s of scraps) s.visible = false;
+    if (!st || st.phase === 'off' || st.phase === 'menu') {
+      for (const g of bodies.values()) g.visible = false;
+      return;
+    }
+    let scrap = 0;
+    for (const f of st.fighters) {
+      const g = bodyFor(f);
+      g.visible = !f.ko;
+      if (!f.ko) {
+        poseRobotBody(g, {
+          pos: [f.x, f.y, f.z],
+          yaw: f.yaw,
+          vel: [f.vx, 0, f.vz],
+          walkPhase: f.walkPhase,
+          crouched: false,
+          climb: null
+        });
+        g.position.set(f.x, f.y, f.z);
+        const tall = f.pose === 'victory' ? 1.8 : 1.65;
+        g.scale.set(1.65, tall, 1.65);
+        const arms = g.userData.arms;
+        if (f.pose === 'victory') {
+          arms[0].rotation.z = arms[1].rotation.z = 0;
+          arms[0].rotation.x = arms[1].rotation.x = -2.6;
+        }
+        else if (f.pose === 'windup') arms[1].rotation.x = -1.6;
+        else if (f.pose === 'punch') arms[1].rotation.x = -2.2;
+        else if (f.pose === 'shield') arms[0].rotation.x = arms[1].rotation.x = -1.2;
+      } else {
+        for (const p of f.parts) {
+          let bit = scraps[scrap];
+          if (!bit) {
+            bit = new T.Mesh(new T.BoxGeometry(0.08, 0.08, 0.08), new T.MeshStandardMaterial({color: f.color}));
+            root.add(bit);
+            scraps.push(bit);
+          }
+          bit.visible = true;
+          bit.position.set(p.x, p.y, p.z);
+          bit.material.color.set(f.color);
+          scrap++;
+        }
+      }
+    }
+    sparks.forEach(s => (s.visible = false));
+    st.sparks.forEach((sp, i) => {
+      const s = sparks[i];
+      if (!s) return;
+      s.visible = true;
+      s.position.set(sp.x, sp.y, sp.z);
+      s.scale.setScalar(0.4 + sp.life * 3);
+    });
+  }
+
+  function sync(players = state?.players ?? 1, paused = false) {
+    const menu = $('arena-menu');
+    const hud = $('arena-hud');
+    const banner = $('arena-banner');
+    const clock = $('arena-clock');
+    if (!state || state.phase === 'off') {
+      if (menu) menu.hidden = true;
+      if (hud) hud.hidden = true;
+      if (banner) banner.hidden = true;
+      return;
+    }
+    if (state.phase === 'menu') state.players = players >= 2 ? 2 : 1;
+    if (menu) {
+      menu.hidden = paused || state.phase !== 'menu';
+      for (const id of ['ladder', 'versus', 'coop']) {
+        const b = $('arena-mode-' + id);
+        if (b) b.hidden = !modeIds(state.players).includes(id);
+      }
+    }
+    const fighting = state.phase !== 'menu';
+    if (hud) hud.hidden = !fighting;
+    if (banner) {
+      banner.hidden = !state.banner || paused;
+      banner.textContent = state.banner || '';
+    }
+    if (clock) {
+      clock.hidden = !state.timerOn || state.clock == null;
+      if (!clock.hidden) clock.textContent = String(Math.ceil(state.clock));
+    }
+    state.fighters.forEach((f, i) => {
+      const row = $('arena-row-' + i);
+      if (!row) return;
+      row.hidden = false;
+      const face = row.querySelector('.arena-face');
+      const bar = row.querySelector('.arena-bar');
+      const fill = bar?.querySelector('span');
+      const hp = row.querySelector('.arena-hp');
+      const name = row.querySelector('.arena-name');
+      const pct = Math.round((100 * f.hp) / f.max);
+      if (face) face.style.setProperty('--face', f.color);
+      if (bar) {
+        bar.style.setProperty('--hp', String(pct));
+        bar.setAttribute('aria-valuenow', String(pct));
+        bar.setAttribute('aria-label', `${f.name} health`);
+      }
+      if (fill) fill.style.width = pct + '%';
+      if (hp) hp.textContent = String(Math.max(0, Math.ceil(f.hp)));
+      if (name) name.textContent = f.name;
+      row.classList.toggle('ko', f.ko);
+    });
+    for (let i = state.fighters.length; i < 3; i++) {
+      const row = $('arena-row-' + i);
+      if (row) row.hidden = true;
+    }
+    const swatch = $('arena-swatch');
+    const colourName = $('arena-colour-name');
+    const current = coloursFor(state).find(c => c.color === state.colour);
+    if (swatch) swatch.style.background = state.colour;
+    if (colourName && current) colourName.textContent = current.name;
+  }
+
+  return {
+    floor,
+    state: () => state,
+    on: () => !!state && state.phase !== 'off',
+    enter(opts = {}) {
+      state = createArena(opts);
+      sync(opts.players, false);
+      pose(state);
+      return state;
+    },
+    choose(mode) {
+      const ok = state ? chooseMode(state, mode) : false;
+      if (ok) {
+        sync(state.players, false);
+        pose(state);
+      }
+      return ok;
+    },
+    step(dt, inputs) {
+      if (!state) return {hits: [], cue: null, rumble: 0, unlocked: false, phase: 'off'};
+      const ev = stepArena(state, inputs, dt);
+      pose(state);
+      sync(state.players, false);
+      return ev;
+    },
+    sync,
+    rematch() {
+      const ok = state ? rematch(state) : false;
+      if (ok) {
+        pose(state);
+        sync(state.players, false);
+      }
+      return ok;
+    },
+    colour() {
+      if (!state) return null;
+      const next = cycleColour(state);
+      sync(state.players, false);
+      pose(state);
+      return next;
+    },
+    leave() {
+      const at = state ? leaveArena(state) : {pos: [...ARENA.exit], yaw: ARENA.exitYaw};
+      state = null;
+      pose(null);
+      sync(1, false);
+      return at;
+    },
+    pulse(t) {
+      domeMat.emissiveIntensity = 0.65 + Math.sin(t * 2.2) * 0.25;
+      lamps.forEach((lamp, i) => {
+        lamp.material.color.setHSL((t * 0.05 + i / 12) % 1, 0.75, 0.62);
+        lamp.position.y = 4.6 + (i % 2) * 0.35 + Math.sin(t * 3 + i) * 0.08;
+      });
+    },
+    dispose() {
+      for (const g of bodies.values()) disposeRobotBody(g);
+      bodies.clear();
+      root.removeFromParent();
+      root.traverse(o => {
+        o.geometry?.dispose();
+        if (o.material?.map) o.material.map.dispose();
+        o.material?.dispose?.();
+      });
+    },
+    label: MODE_LABEL
+  };
+}
