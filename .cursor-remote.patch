diff --git a/web/wwwroot/rc/race-guard.mjs b/web/wwwroot/rc/race-guard.mjs
new file mode 100644
index 00000000..07fc100f
--- /dev/null
+++ b/web/wwwroot/rc/race-guard.mjs
@@ -0,0 +1,46 @@
+// A live race must not be replaced by driving back through the start.
+// Starting a different event asks first. Pure so the TV sequence can be tested
+// without the page: five starts in one session was raceStart quitting the
+// previous one with reason "replaced".
+
+/** @returns {'start'|'ignore'|'confirm'|'replace'} */
+export function raceStartDecision({live = false, trigger = 'event', confirmed = false} = {}) {
+  if (!live) return 'start';
+  if (trigger === 'start-area') return 'ignore';
+  if (confirmed || trigger === 'confirmed') return 'replace';
+  return 'confirm';
+}
+
+/**
+ * True on the frame the car comes back into the start disc after having left it.
+ * The opening grid (already inside, never left) is not a re-entry.
+ */
+export function startAreaReentry(state, inside) {
+  const was = !!state.inside;
+  if (!inside) state.left = true;
+  state.inside = !!inside;
+  return !!(state.left && inside && !was);
+}
+
+/** Arm a timed mode. An open menu defers the clock; it does not start underneath. */
+export function armTimed(state, on, held) {
+  if (!on) {
+    state.pending = false;
+    return 'off';
+  }
+  if (held) {
+    state.pending = true;
+    return 'deferred';
+  }
+  state.pending = false;
+  return 'on';
+}
+
+/** Start a deferred mode on the first frame the menu is gone. */
+export function takePending(state, held) {
+  if (state.pending && !held) {
+    state.pending = false;
+    return true;
+  }
+  return false;
+}
diff --git a/web/wwwroot/rc/race-guard.test.mjs b/web/wwwroot/rc/race-guard.test.mjs
new file mode 100644
index 00000000..79f9d1f4
--- /dev/null
+++ b/web/wwwroot/rc/race-guard.test.mjs
@@ -0,0 +1,37 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {raceStartDecision, startAreaReentry, armTimed, takePending} from './race-guard.mjs';
+
+test('a running race ignores the start area and asks before a different event', () => {
+  assert.equal(raceStartDecision({live: false, trigger: 'event'}), 'start');
+  assert.equal(raceStartDecision({live: false, trigger: 'start-area'}), 'start');
+  assert.equal(raceStartDecision({live: true, trigger: 'start-area'}), 'ignore');
+  assert.equal(raceStartDecision({live: true, trigger: 'event'}), 'confirm');
+  assert.equal(raceStartDecision({live: true, trigger: 'event', confirmed: true}), 'replace');
+  assert.equal(raceStartDecision({live: true, trigger: 'confirmed'}), 'replace');
+});
+
+test('five start-area crossings in one race never replace it', () => {
+  const watch = {inside: false, left: false};
+  const starts = [];
+  // Grid: already inside, then leave, then come back five times (r1..r5 on the TV).
+  assert.equal(startAreaReentry(watch, true), false);
+  for (let n = 0; n < 5; n++) {
+    assert.equal(startAreaReentry(watch, false), false);
+    assert.equal(startAreaReentry(watch, true), true);
+    const decision = raceStartDecision({live: true, trigger: 'start-area'});
+    if (decision === 'start' || decision === 'replace') starts.push(n);
+  }
+  assert.deepEqual(starts, []);
+});
+
+test('hunt or tag armed under an open menu does not start until the menu closes', () => {
+  const mode = {pending: false};
+  assert.equal(armTimed(mode, true, true), 'deferred');
+  assert.equal(mode.pending, true);
+  assert.equal(takePending(mode, true), false, 'menu still open: clock stays off');
+  assert.equal(takePending(mode, false), true, 'menu closed: start now');
+  assert.equal(mode.pending, false);
+  assert.equal(armTimed(mode, false, false), 'off');
+  assert.equal(armTimed(mode, true, false), 'on');
+});
