+// Sparring dummies at the skatepark hub. They wobble, flash and spring home. They do not die.
+// Local offsets are in the residential park frame, a few steps from the spawn (6, 8.7).
+
+export const SPAR_LOCAL = Object.freeze([
+  [9.5, 0.15, 6.2],
+  [2.6, 0.15, 5.8],
+  [6.2, 0.15, 3.1]
+]);
+
+export function createDummy(id, pos, yaw = 0) {
+  return {
+    id,
+    home: [pos[0], pos[1], pos[2]],
+    pos: [pos[0], pos[1], pos[2]],
+    vel: [0, 0, 0],
+    yaw,
+    wobble: 0,
+    flash: 0,
+    down: 0,
+    phase: 0,
+    walkPhase: 0,
+    crouched: false,
+    climb: null
+  };
+}
+
+export function createSparRing(toWorld) {
+  const start = toWorld([6, 0.15, 8.7]);
+  return SPAR_LOCAL.map((p, i) => {
+    const at = toWorld(p),
+      yaw = Math.atan2(start[0] - at[0], -(start[2] - at[2]));
+    return createDummy(101 + i, at, yaw);
+  });
+}
+
+export function bonkSpar(d, ix, iz) {
+  d.vel[0] += ix;
+  d.vel[2] += iz;
+  d.flash = 0.28;
+  d.wobble = 1;
+  d.down = 0.34;
+}
+
+export function stepSpar(list, dt) {
+  const drag = Math.max(0, 1 - 3.2 * dt);
+  for (let i = 0; i < list.length; i++) {
+    const d = list[i];
+    d.vel[0] += (d.home[0] - d.pos[0]) * 8 * dt;
+    d.vel[2] += (d.home[2] - d.pos[2]) * 8 * dt;
+    d.vel[0] *= drag;
+    d.vel[2] *= drag;
+    d.pos[0] += d.vel[0] * dt;
+    d.pos[2] += d.vel[2] * dt;
+    d.pos[1] = d.home[1] + (d.down > 0 ? -0.05 : 0);
+    d.down = Math.max(0, d.down - dt);
+    d.flash = Math.max(0, d.flash - dt);
+    d.wobble = Math.max(0, d.wobble - dt * 1.3);
+    d.phase += dt;
+  }
+}
