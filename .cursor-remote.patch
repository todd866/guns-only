+// The dome you drive up to, and the toys fighting inside it.
+import * as T from '../../vendor/three.module.js';
+import {addBox} from '../physics/world.mjs';
+import {makeRobotBody, poseRobotBody, disposeRobotBody} from '../robot-body.js';
+import {
+  ARENA,
+  MODE_LABEL,
+  chooseMode,
+  coloursFor,
