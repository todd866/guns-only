--- a/web/wwwroot/rc/split-p2.mjs
+++ b/web/wwwroot/rc/split-p2.mjs
@@ -49,8 +49,20 @@ export function flightGamepadInput(gp, poll, mode) {
   };
 }
 
-export function rivalHumanInput({paused, uiPanel, pad2, gp, mode, session, fire, tagBoost, p2Form}) {
-  if (paused || uiPanel) return {throttle: 0, steer: 0, brake: true};
+/** Pause, the brief, the map, or the leave-race row holds both players. */
+export function screenHeld({paused = false, panel = false, brief = false, dialog = false, leave = false} = {}) {
+  return !!(paused || panel || brief || dialog || leave);
+}
+
+/** Full-viewport centre for a panel. Split screen must not park it in player 1's half. */
+export function overlayAnchor(viewportWidth, panelWidth) {
+  const width = Math.min(panelWidth, Math.max(0, viewportWidth - 48));
+  const left = (viewportWidth - width) / 2;
+  return {left, width, center: left + width / 2};
+}
+
+export function rivalHumanInput({paused, uiPanel, held = false, pad2, gp, mode, session, fire, tagBoost, p2Form}) {
+  if (paused || uiPanel || held) return {throttle: 0, steer: 0, brake: true};
   // The walker is its own body. Hold the hidden car so the stick does not drive it.
   if (p2Form === 'robot')
     return {throttle: 0, steer: 0, brake: true, drift: false, fire: false, boost: tagBoost, boardSpin: false};
