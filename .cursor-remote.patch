+// Robot Arena: a couch fighting game for a 6-year-old, played where the hub landmark is.
+// The ring, the rounds and the CPU live here so tests can run them without the renderer.
+// Site: a clear pad north of the main gate, inside the base, off the roads
+// (checked against boundary.mjs and assets/world/overview.json, 6 Nov 2026).
+
+export const ARENA = Object.freeze({
+  id: 'robot-arena',
+  name: 'Robot Arena',
+  short: 'Robot Arena',
+  center: Object.freeze([-600, 0, -200]),
+  gate: Object.freeze([-600, 0, -192.8]),
+  exit: Object.freeze([-600, 0, -184.2]),
+  exitYaw: Math.PI,
+  radius: 2.55,
+  outer: 7.4,
+  gateReach: 3.2,
+  color: '#ff4d6a',
+  icon: '🤖',
+  health: 100,
+  rounds: 2,
+  intro: 1.05,
+  fightCall: 0.7,
+  koTime: 1.55,
+  hitStop: 0.05,
+  cam: Object.freeze({x: 4.4, y: 1.85, z: 3.6, lookY: 0.32}),
+  platforms: Object.freeze([
+    Object.freeze({x: -1.05, z: -0.35, y: 0.48, w: 0.78}),
+    Object.freeze({x: 1.05, z: -0.35, y: 0.48, w: 0.78}),
+    Object.freeze({x: 0, z: 0.95, y: 0.78, w: 0.86})
+  ])
+});
+
+export const ARENA_PLACE = Object.freeze({
+  id: ARENA.id,
+  name: ARENA.name,
+  short: ARENA.short,
+  pos: [...ARENA.gate],
+  color: ARENA.color,
+  icon: ARENA.icon,
+  kind: 'activity',
+  game: 'robot-arena'
+});
+
+// Earned by clearing the ladder. The Garage offers it only after the trophy.
+export const ARENA_PAINT = Object.freeze({name: 'Champion', color: '#f0c14a', earned: 'arena'});
+
+// Same colours the Garage already saves, so a pause-menu change is a real paint.
+export const FIGHTER_COLOURS = Object.freeze([
+  Object.freeze({name: 'Viper Punks', color: '#ed9145'}),
+  Object.freeze({name: 'Arctic', color: '#d7e5e8'}),
+  Object.freeze({name: 'Aggressor', color: '#6a9dbf'}),
+  Object.freeze({name: 'Mudhen', color: '#b5a17b'}),
+  Object.freeze({name: 'Night', color: '#74728d'})
+]);
+
+export const OPPONENTS = Object.freeze([
+  Object.freeze({id: 'sparky', name: 'Sparky', color: '#5ec8ff', tier: 'easy'}),
+  Object.freeze({id: 'bolt', name: 'Bolt', color: '#ff6b4a', tier: 'easy'}),
+  Object.freeze({id: 'titan', name: 'Titan', color: '#c084fc', tier: 'medium'})
+]);
+
+// A combo from full health must leave a kid standing, and every swing is telegraphed.
+export const CPU_BOUNDS = Object.freeze({
+  telegraphMin: 0.5,
+  blockMax: 0.4,
+  comboMax: 2,
+  comboKoFraction: 0.45
+});
+
+export const CPU = Object.freeze({
+  easy: Object.freeze({telegraph: 0.9, block: 0.12, comboMax: 1, damage: 7, blaster: 0.08}),
+  medium: Object.freeze({telegraph: 0.62, block: 0.32, comboMax: 2, damage: 9, blaster: 0.16})
+});
+
+export const MODE_LABEL = Object.freeze({
+  ladder: 'Vs CPU',
+  versus: 'Vs friend',
+  coop: 'Both vs CPU'
+});
+
+const SPEED = 2.05;
+const DASH = 5.4;
+const PUNCH = Object.freeze({damage: 8, range: 0.52});
+const POWER = Object.freeze({damage: 16, range: 0.64});
+const POUND = Object.freeze({damage: 14, radius: 0.85});
+const BLAST = Object.freeze({damage: 7, speed: 4.2});
+
+export function cpuWithinBounds(tier) {
+  const c = CPU[tier];
+  if (!c) return false;
+  const combo = c.damage * c.comboMax;
+  return (
+    c.telegraph >= CPU_BOUNDS.telegraphMin &&
+    c.block <= CPU_BOUNDS.blockMax &&
+    c.block >= 0 &&
+    c.comboMax >= 1 &&
+    c.comboMax <= CPU_BOUNDS.comboMax &&
+    combo < ARENA.health * CPU_BOUNDS.comboKoFraction &&
+    combo < ARENA.health
+  );
+}
+
+// One random sample in, one decision out. A follow-up that would KO is a step back, not a swing.
+export function cpuDecision(spec, s) {
+  const lethalFollow = s.combo > 0 && (s.foeHp <= spec.damage || s.combo >= spec.comboMax);
+  if (lethalFollow) return {back: true};
+  const threat =
+    s.foePose === 'punch' || s.foePose === 'power' || s.foePose === 'pound' || s.foePose === 'windup';
+  if (threat && s.random < spec.block) return {shield: true};
+  if (s.dist <= 0.72 && !(s.windup > 0)) {
+    const kind = s.random < spec.blaster ? 'blaster' : s.random > 0.72 ? 'power' : 'punch';
+    return {windup: true, kind};
+  }
+  return {approach: true};
+}
+
+export function modeIds(players) {
+  return players >= 2 ? ['ladder', 'versus', 'coop'] : ['ladder'];
+}
+
+export function coloursFor(st) {
+  const list = [...FIGHTER_COLOURS];
+  if (st?.trophy && !list.some(c => c.color === ARENA_PAINT.color)) list.push(ARENA_PAINT);
+  return list;
+}
+
+export function extraPaints(progress) {
+  return progress?.arenaTrophy ? [ARENA_PAINT] : [];
+}
+
+export function grantArenaTrophy(progress) {
+  if (!progress) return null;
+  const first = !progress.arenaTrophy;
+  progress.arenaTrophy = true;
+  return first ? ARENA_PAINT : null;
+}
+
+export function inArenaGate(pos) {
+  if (!pos) return false;
+  return Math.hypot(pos[0] - ARENA.gate[0], pos[2] - ARENA.gate[2]) <= ARENA.gateReach;
+}
+
+export function arenaCamYaw() {
+  return Math.atan2(-ARENA.cam.x, ARENA.cam.z);
+}
+
+export function createArena({players = 1, colour = FIGHTER_COLOURS[0].color, trophy = false, random = Math.random} = {}) {
+  return {
+    phase: 'menu',
+    mode: null,
+    players: players >= 2 ? 2 : 1,
+    colour,
+    trophy: !!trophy,
+    ladder: 0,
+    round: 1,
+    scores: [0, 0],
+    banner: '',
+    bannerT: 0,
+    cue: null,
+    fighters: [],
+    shots: [],
+    sparks: [],
+    hitStop: 0,
+    koT: 0,
+    timerOn: false,
+    clock: null,
+    winnerSide: null,
+    rumble: 0,
+    unlockCue: false,
+    random
+  };
+}
+
+function foeOf(st, f) {
+  let best = null,
+    bestD = Infinity;
+  for (const o of st.fighters) {
+    if (o.side === f.side || o.ko) continue;
+    const d = Math.hypot(o.x - f.x, o.z - f.z);
+    if (d < bestD) {
+      best = o;
+      bestD = d;
+    }
+  }
+  return best;
+}
+
+function makeFighter(id, side, name, color, spot, cpu = null) {
+  return {
+    id,
+    side,
+    name,
+    color,
+    cpu,
+    hp: ARENA.health,
+    max: ARENA.health,
+    x: spot.x,
+    z: spot.z,
+    y: 0,
+    vx: 0,
+    vz: 0,
+    vy: 0,
+    yaw: spot.yaw,
+    grounded: true,
+    shield: false,
+    combo: 0,
+    comboT: 0,
+    powerCd: 0,
+    blastCd: 0,
+    dashT: 0,
+    dashCd: 0,
+    pose: 'idle',
+    poseT: 0,
+    windup: 0,
+    intent: null,
+    stunned: 0,
+    ko: false,
+    parts: [],
+    walkPhase: 0,
+    wasPunch: false,
+    wasPower: false,
+    wasDash: false,
+    wasBlast: false,
+    wasJump: false
+  };
+}
+
+function lineup(st) {
+  const opp = OPPONENTS[Math.min(st.ladder, OPPONENTS.length - 1)];
+  const south = {x: 0, z: 1.15, yaw: 0},
+    north = {x: 0, z: -1.15, yaw: Math.PI};
+  const list = [makeFighter('p1', 0, 'You', st.colour, st.mode === 'coop' ? {x: -0.45, z: 1.15, yaw: 0} : south)];
+  if (st.mode === 'versus' || st.mode === 'coop')
+    list.push(makeFighter('p2', st.mode === 'versus' ? 1 : 0, 'P2', '#f05aa6', st.mode === 'coop' ? {x: 0.45, z: 1.15, yaw: 0} : north));
+  if (st.mode === 'ladder' || st.mode === 'coop')
+    list.push(makeFighter(opp.id, 1, opp.name, opp.color, north, opp.tier));
+  st.fighters = list;
+  st.shots = [];
+  st.sparks = [];
+}
+
+function cue(st, name) {
+  st.banner = name;
+  st.cue = name;
+}
+
+export function chooseMode(st, mode) {
+  if (!st || st.phase !== 'menu' || !modeIds(st.players).includes(mode)) return false;
+  st.mode = mode;
+  st.ladder = 0;
+  st.round = 1;
+  st.scores = [0, 0];
+  st.winnerSide = null;
+  beginRound(st);
+  return true;
+}
+
+function beginRound(st) {
+  lineup(st);
+  st.phase = 'intro';
+  st.bannerT = ARENA.intro;
+  st.koT = 0;
+  st.hitStop = 0;
+  st.winnerSide = null;
+  st.clock = st.timerOn ? 60 : null;
+  cue(st, `ROUND ${st.round}`);
+}
+
+export function setRoundTimer(st, on) {
+  st.timerOn = !!on;
+  st.clock = st.timerOn && st.phase === 'fight' ? 60 : st.timerOn ? st.clock : null;
+  return st.timerOn;
+}
+
+export function cycleColour(st) {
+  const list = coloursFor(st);
+  const i = Math.max(0, list.findIndex(c => c.color === st.colour));
+  const next = list[(i + 1) % list.length];
+  st.colour = next.color;
+  const p1 = st.fighters.find(f => f.id === 'p1');
+  if (p1) p1.color = next.color;
+  return next;
+}
+
+export function rematch(st) {
+  if (!st?.mode || st.phase === 'off' || st.phase === 'menu') return false;
+  if (st.ladder >= OPPONENTS.length) st.ladder = OPPONENTS.length - 1;
+  st.round = 1;
+  st.scores = [0, 0];
+  st.winnerSide = null;
+  beginRound(st);
+  return true;
+}
+
+export function leaveArena(st) {
+  st.phase = 'off';
+  st.banner = '';
+  st.fighters = [];
+  return {pos: [...ARENA.exit], yaw: ARENA.exitYaw};
+}
+
+function down(st, f) {
+  f.ko = true;
+  f.hp = 0;
+  f.pose = 'parts';
+  f.parts = Array.from({length: 6}, (_, i) => {
+    const a = (i / 6) * Math.PI * 2;
+    return {x: f.x, y: 0.22, z: f.z, vx: Math.cos(a) * 1.5, vy: 2.1 + (i % 3) * 0.35, vz: Math.sin(a) * 1.5};
+  });
+}
+
+function frontal(from, to) {
+  const dx = from.x - to.x,
+    dz = from.z - to.z,
+    dist = Math.hypot(dx, dz) || 1;
+  return dx * Math.sin(to.yaw) + dz * -Math.cos(to.yaw) > dist * 0.25;
+}
+
+function applyHit(st, from, to, spec) {
+  if (!to || to.ko || to.side === from.side) return false;
+  if (to.shield && frontal(from, to)) return false;
+  if (from.cpu && spec.combo > 1 && to.hp <= spec.damage) return false;
+  to.hp = Math.max(0, to.hp - spec.damage);
+  to.stunned = 0.16;
+  to.vx += Math.sin(from.yaw) * 2.2;
+  to.vz -= Math.cos(from.yaw) * 2.2;
+  st.hitStop = ARENA.hitStop;
+  st.rumble = Math.max(st.rumble, spec.kind === 'power' || spec.kind === 'pound' ? 0.8 : 0.45);
+  st.sparks.push({x: (from.x + to.x) / 2, y: to.y + 0.28, z: (from.z + to.z) / 2, life: 0.22});
+  const ko = to.hp <= 0;
+  if (ko) down(st, to);
+  st.hits.push({
+    t: st.age,
+    from: from.id,
+    id: to.id,
+    damage: spec.damage,
+    kind: spec.kind,
+    combo: spec.combo,
+    ko
+  });
+  return true;
+}
+
+function melee(st, from, spec) {
+  const fx = Math.sin(from.yaw),
+    fz = -Math.cos(from.yaw);
+  for (const to of st.fighters) {
+    if (to.side === from.side || to.ko) continue;
+    const dx = to.x - from.x,
+      dz = to.z - from.z,
+      dist = Math.hypot(dx, dz);
+    if (dist > spec.range || dist < 1e-6) continue;
+    if ((dx * fx + dz * fz) / dist < 0.15) continue;
+    applyHit(st, from, to, spec);
+  }
+}
+
+function pound(st, from) {
+  for (const to of st.fighters) {
+    if (to.side === from.side || to.ko) continue;
+    if (Math.hypot(to.x - from.x, to.z - from.z) <= POUND.radius)
+      applyHit(st, from, to, {kind: 'pound', damage: POUND.damage, combo: 1});
+  }
+}
+
+function spawnBlast(st, from, damage) {
+  const spec = from.cpu ? CPU[from.cpu] : null;
+  st.shots.push({
+    x: from.x + Math.sin(from.yaw) * 0.3,
+    z: from.z - Math.cos(from.yaw) * 0.3,
+    y: from.y + 0.22,
+    vx: Math.sin(from.yaw) * BLAST.speed,
+    vz: -Math.cos(from.yaw) * BLAST.speed,
+    side: from.side,
+    from: from.id,
+    damage: damage ?? BLAST.damage,
+    combo: 1,
+    cpu: !!from.cpu,
+    cpuDamage: spec?.damage ?? BLAST.damage,
+    life: 0.7
+  });
+}
+
+function releaseIntent(st, f) {
+  const kind = f.intent || 'punch';
+  f.intent = null;
+  const spec = CPU[f.cpu];
+  if (kind === 'punch') {
+    f.combo = (f.comboT > 0 ? f.combo : 0) + 1;
+    f.comboT = 0.75;
+    if (f.combo > 1) {
+      const foe = foeOf(st, f);
+      if (foe && foe.hp <= spec.damage) {
+        f.combo = 0;
+        f.pose = 'idle';
+        return;
+      }
+    }
+    f.pose = 'punch';
+    f.poseT = 0.2;
+    melee(st, f, {kind: 'punch', damage: spec.damage, range: 0.56, combo: f.combo});
+    return;
+  }
+  if (kind === 'power') {
+    f.pose = 'power';
+    f.poseT = 0.26;
+    f.combo = 0;
+    melee(st, f, {kind: 'power', damage: spec.damage + 4, range: 0.66, combo: 1});
+    return;
+  }
+  f.pose = 'blast';
+  f.poseT = 0.16;
+  spawnBlast(st, f, spec.damage);
+}
+
+function cpuInput(st, f) {
+  const spec = CPU[f.cpu];
+  const foe = foeOf(st, f);
+  if (!foe) return {};
+  const dx = foe.x - f.x,
+    dz = foe.z - f.z,
+    dist = Math.hypot(dx, dz) || 1e-6;
+  f.yaw = Math.atan2(dx, -dz);
+  const decision = cpuDecision(spec, {
+    dist,
+    foePose: foe.pose,
+    foeHp: foe.hp,
+    combo: f.combo,
+    random: st.random(),
+    windup: f.windup
+  });
+  const input = {x: 0, z: 0, lock: true};
+  if (decision.back) {
+    input.x = -dx / dist;
+    input.z = -dz / dist;
+    return input;
+  }
+  if (decision.shield) {
+    input.shield = true;
+    return input;
+  }
+  if (dist > 0.5) {
+    input.x = dx / dist;
+    input.z = dz / dist;
+  }
+  if (decision.windup && f.windup <= 0 && !f.intent) {
+    f.intent = decision.kind;
+    f.windup = spec.telegraph;
+    f.pose = 'windup';
+  }
+  return input;
+}
+
+function bounce(f) {
+  const d = Math.hypot(f.x, f.z);
+  if (d <= ARENA.radius) return;
+  const k = ARENA.radius / d;
+  f.x *= k;
+  f.z *= k;
+  const nx = f.x / ARENA.radius,
+    nz = f.z / ARENA.radius,
+    vn = f.vx * nx + f.vz * nz;
+  if (vn > 0) {
+    f.vx -= 1.9 * vn * nx;
+    f.vz -= 1.9 * vn * nz;
+  }
+}
+
+function floors(f) {
+  let floor = 0;
+  for (const p of ARENA.platforms) {
+    if (Math.abs(f.x - p.x) <= p.w / 2 && Math.abs(f.z - p.z) <= p.w / 2 && f.y >= p.y - 0.08 && f.vy <= 0)
+      floor = Math.max(floor, p.y);
+  }
+  return floor;
+}
+
+function stepFighter(st, f, input, dt) {
+  if (f.ko) {
+    for (const p of f.parts) {
+      p.vy -= 14 * dt;
+      p.x += p.vx * dt;
+      p.y += p.vy * dt;
+      p.z += p.vz * dt;
+      if (p.y < 0) {
+        p.y = 0;
+        p.vy = Math.abs(p.vy) * 0.55;
+        p.vx *= 0.82;
+        p.vz *= 0.82;
+      }
+      const d = Math.hypot(p.x, p.z);
+      if (d > ARENA.radius) {
+        p.x *= ARENA.radius / d;
+        p.z *= ARENA.radius / d;
+        p.vx *= -0.6;
+        p.vz *= -0.6;
+      }
+    }
+    return;
+  }
+  input ||= {};
+  f.comboT = Math.max(0, f.comboT - dt);
+  if (f.comboT === 0) f.combo = 0;
+  f.powerCd = Math.max(0, f.powerCd - dt);
+  f.blastCd = Math.max(0, f.blastCd - dt);
+  f.dashCd = Math.max(0, f.dashCd - dt);
+  f.dashT = Math.max(0, f.dashT - dt);
+  f.stunned = Math.max(0, f.stunned - dt);
+  f.shield = !!input.shield && f.grounded && f.stunned <= 0 && f.windup <= 0;
+  if (input.lock) {
+    const foe = foeOf(st, f);
+    if (foe) f.yaw = Math.atan2(foe.x - f.x, -(foe.z - f.z));
+  }
+  const punchEdge = !!input.punch && !f.wasPunch;
+  const powerEdge = !!input.power && !f.wasPower;
+  const dashEdge = !!input.dash && !f.wasDash;
+  const blastEdge = !!input.blaster && !f.wasBlast;
+  f.wasPunch = !!input.punch;
+  f.wasPower = !!input.power;
+  f.wasDash = !!input.dash;
+  f.wasBlast = !!input.blaster;
+
+  if (f.windup > 0) {
+    f.windup -= dt;
+    f.pose = 'windup';
+    if (f.windup <= 0) releaseIntent(st, f);
+  } else if (punchEdge && !f.shield && f.stunned <= 0) {
+    if (!f.grounded) {
+      f.pose = 'pound';
+      f.vy = Math.min(f.vy, -6.5);
+    } else {
+      f.combo = Math.min(3, (f.comboT > 0 ? f.combo : 0) + 1);
+      f.comboT = 0.42;
+      f.pose = 'punch';
+      f.poseT = 0.16;
+      melee(st, f, {kind: 'punch', damage: PUNCH.damage + (f.combo - 1) * 2, range: PUNCH.range, combo: f.combo});
+    }
+  } else if (powerEdge && f.powerCd <= 0 && f.grounded && !f.shield && f.stunned <= 0) {
+    f.powerCd = 1.15;
+    f.pose = 'power';
+    f.poseT = 0.24;
+    melee(st, f, {kind: 'power', damage: POWER.damage, range: POWER.range, combo: 1});
+  } else if (blastEdge && f.blastCd <= 0 && !f.shield && f.stunned <= 0) {
+    f.blastCd = 0.48;
+    f.pose = 'blast';
+    f.poseT = 0.14;
+    spawnBlast(st, f);
+  }
+
+  let ix = input.x || 0,
+    iz = input.z || 0;
+  const mag = Math.hypot(ix, iz);
+  if (mag > 1) {
+    ix /= mag;
+    iz /= mag;
+  }
+  if (f.shield || f.windup > 0) {
+    ix *= 0.2;
+    iz *= 0.2;
+  }
+  if (f.stunned > 0) {
+    ix *= 0.15;
+    iz *= 0.15;
+  }
+  if (!input.lock && mag > 0.2 && f.windup <= 0) f.yaw = Math.atan2(ix, -iz);
+  if (dashEdge && f.dashCd <= 0 && f.grounded && !f.shield) {
+    f.dashT = 0.14;
+    f.dashCd = 0.55;
+    f.vx = Math.sin(f.yaw) * DASH;
+    f.vz = -Math.cos(f.yaw) * DASH;
+  }
+  if (f.dashT <= 0) {
+    f.vx = ix * SPEED;
+    f.vz = iz * SPEED;
+  }
+  if (input.jump && f.grounded && !f.wasJump && f.windup <= 0) {
+    f.vy = 3.5;
+    f.grounded = false;
+  }
+  f.wasJump = !!input.jump;
+  if (!f.grounded) {
+    if (input.jump) f.vy = Math.min(2.4, f.vy + 12 * dt);
+    f.vy -= 14 * dt;
+  }
+  f.x += f.vx * dt;
+  f.z += f.vz * dt;
+  f.y += f.vy * dt;
+  const floor = floors(f);
+  if (f.y <= floor && f.vy <= 0) {
+    const slamming = f.pose === 'pound' && !f.grounded;
+    f.y = floor;
+    f.vy = 0;
+    f.grounded = true;
+    if (slamming) {
+      f.pose = 'idle';
+      pound(st, f);
+    }
+  } else if (f.y > floor + 0.03) f.grounded = false;
+  bounce(f);
+  f.walkPhase += Math.hypot(f.vx, f.vz) * dt * 8;
+  if (f.poseT > 0) f.poseT -= dt;
+  if (f.pose !== 'windup' && f.pose !== 'pound' && f.poseT <= 0)
+    f.pose = f.shield ? 'shield' : Math.hypot(f.vx, f.vz) > 0.35 ? 'walk' : 'idle';
+}
+
+function stepShots(st, dt) {
+  for (const s of st.shots) {
+    s.x += s.vx * dt;
+    s.z += s.vz * dt;
+    s.life -= dt;
+    if (Math.hypot(s.x, s.z) > ARENA.radius) s.life = 0;
+    for (const to of st.fighters) {
+      if (s.life <= 0 || to.side === s.side || to.ko) continue;
+      if (Math.hypot(to.x - s.x, to.z - s.z) > 0.28) continue;
+      const from = st.fighters.find(f => f.id === s.from) || {id: s.from, side: s.side, x: s.x, z: s.z, yaw: 0, cpu: s.cpu};
+      applyHit(st, from, to, {kind: 'blast', damage: s.damage, combo: 1});
+      s.life = 0;
+    }
+  }
+  st.shots = st.shots.filter(s => s.life > 0);
+}
+
+function aliveSides(st) {
+  for (const f of st.fighters) if (f.hp <= 0 && !f.ko) down(st, f);
+  return [...new Set(st.fighters.filter(f => !f.ko && f.hp > 0).map(f => f.side))];
+}
+
+function finishRound(st, winner) {
+  st.winnerSide = winner;
+  if (winner == null) {
+    beginRound(st);
+    return;
+  }
+  st.scores[winner]++;
+  st.phase = 'ko';
+  st.koT = ARENA.koTime;
+  cue(st, 'K.O.!');
+  for (const f of st.fighters) if (!f.ko && f.side === winner) f.pose = 'victory';
+}
+
+function settle(st) {
+  if (st.phase !== 'fight') return;
+  const sides = aliveSides(st);
+  if (sides.length === 1) finishRound(st, sides[0]);
+  else if (sides.length === 0) finishRound(st, null);
+}
+
+function afterKo(st) {
+  const winner = st.winnerSide;
+  if (winner == null) {
+    beginRound(st);
+    return;
+  }
+  if (st.scores[winner] >= ARENA.rounds) {
+    if (winner === 0 && (st.mode === 'ladder' || st.mode === 'coop')) {
+      st.ladder++;
+      if (st.ladder >= OPPONENTS.length) {
+        st.phase = 'trophy';
+        st.trophy = true;
+        st.bannerT = 2.4;
+        cue(st, 'CHAMPION!');
+        st.unlockCue = true;
+        for (const f of st.fighters) if (f.side === 0) f.pose = 'victory';
+        return;
+      }
+      st.scores = [0, 0];
+      st.round = 1;
+      beginRound(st);
+      return;
+    }
+    st.phase = 'match';
+    st.bannerT = 2.2;
+    const name = st.fighters.find(f => f.side === winner)?.name || 'K.O.!';
+    cue(st, name);
+    for (const f of st.fighters) if (f.side === winner) f.pose = 'victory';
+    return;
+  }
+  st.round++;
+  beginRound(st);
+}
+
+function take(st) {
+  const out = {hits: st.hits, cue: st.cue, rumble: st.rumble, unlocked: st.unlockCue, phase: st.phase};
+  st.hits = [];
+  st.cue = null;
+  st.rumble = 0;
+  st.unlockCue = false;
+  return out;
+}
+
+export function stepArena(st, inputs = [], dt = 1 / 60) {
+  st.hits = [];
+  st.age = (st.age || 0) + dt;
+  if (!st || st.phase === 'off' || st.phase === 'menu') return take(st);
+  st.sparks = st.sparks.filter(s => (s.life -= dt) > 0);
+  if (st.hitStop > 0) {
+    st.hitStop = Math.max(0, st.hitStop - dt);
+    return take(st);
+  }
+  if (st.phase === 'intro') {
+    st.bannerT -= dt;
+    if (st.banner === `ROUND ${st.round}` && st.bannerT <= 0) {
+      st.bannerT = ARENA.fightCall;
+      cue(st, 'FIGHT!');
+    } else if (st.banner === 'FIGHT!' && st.bannerT <= 0) {
+      st.phase = 'fight';
+      st.banner = '';
+      if (st.timerOn) st.clock = 60;
+    }
+    return take(st);
+  }
+  if (st.phase === 'ko') {
+    st.koT -= dt;
+    for (const f of st.fighters) if (f.ko) stepFighter(st, f, {}, dt);
+    if (st.koT <= 0) afterKo(st);
+    return take(st);
+  }
+  if (st.phase === 'trophy' || st.phase === 'match') {
+    st.bannerT -= dt;
+    return take(st);
+  }
+  const pad = inputs.length ? inputs : st.fighters.map(() => ({}));
+  let human = 0;
+  for (const f of st.fighters) {
+    const input = f.cpu ? cpuInput(st, f) : pad[human++] || {};
+    stepFighter(st, f, input, dt);
+  }
+  stepShots(st, dt);
+  if (st.timerOn && st.clock != null) {
+    st.clock = Math.max(0, st.clock - dt);
+    if (st.clock === 0 && st.phase === 'fight') {
+      const hp = [0, 0];
+      for (const f of st.fighters) if (!f.ko) hp[f.side] += f.hp;
+      finishRound(st, hp[0] === hp[1] ? null : hp[0] > hp[1] ? 0 : 1);
+    }
+  }
+  settle(st);
+  return take(st);
+}
