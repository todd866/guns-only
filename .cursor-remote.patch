diff --git a/web/wwwroot/rc/robot-fight.test.mjs b/web/wwwroot/rc/robot-fight.test.mjs
new file mode 100644
index 00000000..7538d99a
--- /dev/null
+++ b/web/wwwroot/rc/robot-fight.test.mjs
@@ -0,0 +1,206 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {MOVES, createMoves, stepMoves, pickLockTarget, bumpRobots} from './robot-moves.mjs';
+import {createDummy, bonkSpar, stepSpar} from './robot-spar.mjs';
+
+const bot = (grounded = true) => ({pos: [0, 0, 0], vel: [0, 0, 0], yaw: 0, grounded});
+const hold = (extra = {}) => ({punchHeld: false, powerHeld: false, jumpHeld: false, dashHeld: false, lockHeld: false, fireHeld: false, shieldHeld: false, move: null, ...extra});
+
+function until(m, r, pred, input, targets = [], dt = 1 / 120) {
+  let out = null;
+  for (let i = 0; i < 80 && !pred(); i++) out = stepMoves(m, r, input, targets, targets.length, dt);
+  return out;
+}
+
+test('X-X-X is jab, jab, swing, and a late tap starts over', () => {
+  const m = createMoves(),
+    r = bot(true),
+    foe = {id: 'foe', pos: [0, 0, -0.3], kind: 'dummy'};
+  stepMoves(m, r, hold({punchHeld: true}), [foe], 1);
+  assert.equal(m.action, 'jab');
+  until(m, r, () => m.action !== 'jab', hold(), [foe]);
+  assert.equal(m.combo, 1);
+  stepMoves(m, r, hold({punchHeld: true}), [foe], 1);
+  assert.equal(m.action, 'jab2');
+  until(m, r, () => m.action !== 'jab2', hold(), [foe]);
+  assert.equal(m.combo, 2);
+  stepMoves(m, r, hold({punchHeld: true}), [foe], 1);
+  assert.equal(m.action, 'swing');
+  until(m, r, () => m.action === 'idle', hold(), [foe]);
+  for (let i = 0; i < 80; i++) stepMoves(m, r, hold(), [], 0);
+  assert.equal(m.combo, 0, 'the combo window closed');
+  stepMoves(m, r, hold({punchHeld: true}), [], 0);
+  assert.equal(m.action, 'jab');
+});
+
+test('a jab connects in front and hit-stop freezes the next sample', () => {
+  const m = createMoves(),
+    r = bot(true),
+    foe = {id: 'foe', pos: [0, 0, -0.3], kind: 'dummy', body: {vel: [0, 0, 0]}};
+  stepMoves(m, r, hold({punchHeld: true}), [foe], 1);
+  let hits = 0;
+  for (let i = 0; i < 40; i++) {
+    const out = stepMoves(m, r, hold(), [foe], 1);
+    hits += out.hitCount;
+    if (m.hitStop > 0) break;
+  }
+  assert.ok(hits >= 1, 'the jab reaches the dummy');
+  assert.ok(m.hitBuf[0].iz < -1, 'knockback is away from the robot');
+  assert.equal(m.hitBuf[0].blocked, false);
+  const frozen = stepMoves(m, r, hold(), [foe], 1);
+  assert.equal(frozen.frozen, true);
+  assert.ok(m.hitStop >= 0);
+});
+
+test('a shield soaks the hit', () => {
+  const m = createMoves(),
+    r = bot(true),
+    foe = {id: 'foe', pos: [0, 0, -0.3], shield: true};
+  stepMoves(m, r, hold({punchHeld: true}), [foe], 1);
+  let blocked = false;
+  for (let i = 0; i < 40; i++) {
+    const out = stepMoves(m, r, hold(), [foe], 1);
+    if (out.hitCount && m.hitBuf[0].blocked) blocked = true;
+  }
+  assert.equal(blocked, true);
+  assert.equal(m.hitBuf[0].ix, 0);
+  assert.equal(m.hitBuf[0].iz, 0);
+});
+
+test('Y is an uppercut standing still and a spinning kick while moving', () => {
+  const still = createMoves(),
+    a = bot(true);
+  stepMoves(still, a, hold({powerHeld: true, move: {x: 0, z: 0}}), [], 0);
+  assert.equal(still.action, 'upper');
+  assert.ok(a.vel[1] > 2);
+  const go = createMoves(),
+    b = bot(true);
+  b.vel[0] = 1;
+  stepMoves(go, b, hold({powerHeld: true, move: {x: 1, z: 0}}), [], 0);
+  assert.equal(go.action, 'spin');
+});
+
+test('jetpack fuel lasts about four seconds and refills on the ground in about two', () => {
+  const m = createMoves(),
+    r = bot(false);
+  r.pos[1] = 2;
+  let t = 0;
+  while (m.fuel > 0 && t < 6) {
+    stepMoves(m, r, hold({jumpHeld: true}), [], 0, 0.05);
+    r.grounded = false;
+    t += 0.05;
+  }
+  assert.ok(t > 3.7 && t < 4.4, `thrust time ${t}`);
+  assert.equal(m.thrusting, false);
+  assert.ok(m.fuel <= 0.05);
+  r.grounded = true;
+  t = 0;
+  while (m.fuel < MOVES.fuelMax - 0.05 && t < 4) {
+    stepMoves(m, r, hold(), [], 0, 0.05);
+    t += 0.05;
+  }
+  assert.ok(t > 1.6 && t < 2.4, `refill time ${t}`);
+  assert.ok(m.fuel > MOVES.fuelMax - 0.2);
+});
+
+test('holding A on the ground jumps once, and holding it in the air thrusts', () => {
+  const m = createMoves(),
+    r = bot(true);
+  stepMoves(m, r, hold({jumpHeld: true}), [], 0, 1 / 120);
+  assert.equal(r.grounded, false);
+  assert.ok(r.vel[1] > 2);
+  assert.equal(m.thrusting, false, 'the jump frame is not yet thrust');
+  r.vel[1] = 0.2;
+  stepMoves(m, r, hold({jumpHeld: true}), [], 0, 1 / 120);
+  assert.equal(m.thrusting, true);
+  const before = m.fuel;
+  stepMoves(m, r, hold({jumpHeld: true}), [], 0, 1 / 120);
+  assert.ok(m.fuel < before);
+});
+
+test('air X is a ground-pound: dive, then a shockwave on landing', () => {
+  const m = createMoves(),
+    r = bot(false),
+    car = {id: 'car', pos: [0.2, 0, -0.3], kind: 'car', body: {vel: [0, 0, 0]}};
+  r.pos[1] = 1.2;
+  stepMoves(m, r, hold(), [], 0);
+  stepMoves(m, r, hold({punchHeld: true}), [car], 1);
+  assert.equal(m.action, 'pound');
+  assert.ok(r.vel[1] <= MOVES.dive);
+  const air = stepMoves(m, r, hold({punchHeld: true}), [car], 1);
+  assert.equal(air.shock, false);
+  r.grounded = true;
+  r.pos[1] = 0;
+  const land = stepMoves(m, r, hold({punchHeld: true}), [car], 1);
+  assert.equal(land.shock, true);
+  assert.equal(land.landed, true);
+  assert.ok(land.hitCount >= 1);
+  assert.ok(Math.hypot(m.hitBuf[0].ix, m.hitBuf[0].iz) > 2);
+  assert.ok(land.rumble >= 1);
+});
+
+test('a plain landing is soft: dust flag, no shock', () => {
+  const m = createMoves(),
+    r = bot(false);
+  stepMoves(m, r, hold(), [], 0);
+  r.grounded = true;
+  const out = stepMoves(m, r, hold(), [], 0);
+  assert.equal(out.landed, true);
+  assert.equal(out.shock, false);
+});
+
+test('lock-on picks the nearest target inside range and clears when let go', () => {
+  const targets = [
+      {id: 'far', pos: [0, 0, -9]},
+      {id: 'near', pos: [0.4, 0, -1.2]},
+      {id: 'mid', pos: [-2, 0, -3]}
+    ],
+    origin = [0, 0, 0];
+  assert.equal(pickLockTarget(origin, targets, 3, MOVES.lockRange), 1);
+  assert.equal(pickLockTarget(origin, targets, 3, 0.5), -1);
+  const m = createMoves(),
+    r = bot(true);
+  stepMoves(m, r, hold({lockHeld: true}), targets, 3);
+  assert.equal(m.lockId, 'near');
+  assert.ok(Math.abs(m.lockPos[2] + 1.2) < 1e-9);
+  stepMoves(m, r, hold({lockHeld: false}), targets, 3);
+  assert.equal(m.lockId, null);
+});
+
+test('RB dashes along the stick and strikes recover inside 300 ms', () => {
+  const m = createMoves(),
+    r = bot(true);
+  stepMoves(m, r, hold({dashHeld: true, move: {x: 1, z: 0}}), [], 0);
+  assert.equal(m.action, 'dash');
+  assert.ok(r.vel[0] > 4 && Math.abs(r.vel[2]) < 0.2);
+  for (const t of [MOVES.jab, MOVES.swing, MOVES.upper, MOVES.spin, MOVES.dash, MOVES.shield])
+    assert.ok(t <= 0.3, t);
+});
+
+test('LB raises a brief shield', () => {
+  const m = createMoves(),
+    r = bot(true);
+  stepMoves(m, r, hold({shieldHeld: true}), [], 0, 1 / 60);
+  assert.ok(m.shieldLeft > 0.2);
+  assert.equal(m.pose, 'shield');
+  for (let i = 0; i < 40; i++) stepMoves(m, r, hold({shieldHeld: true}), [], 0, 1 / 60);
+  assert.equal(m.shieldLeft, 0, 'it drops even if the button stays down');
+});
+
+test('two robots bump apart and a dummy pops back up', () => {
+  const a = bot(true),
+    b = bot(true);
+  a.moves = createMoves();
+  b.moves = createMoves();
+  b.pos[0] = 0.1;
+  assert.equal(bumpRobots(a, b, 1 / 120), true);
+  assert.ok(a.vel[0] < 0 && b.vel[0] > 0);
+  assert.equal(bumpRobots(a, b, 1 / 120), false, 'one spark per contact');
+  const d = createDummy(101, [0, 0, 0], 0);
+  bonkSpar(d, 3, -1);
+  assert.ok(d.flash > 0 && d.wobble > 0 && d.down > 0);
+  for (let i = 0; i < 120 * 3; i++) stepSpar([d], 1 / 120);
+  assert.ok(Math.hypot(d.pos[0], d.pos[2]) < 0.2, `home again ${d.pos}`);
+  assert.equal(d.down, 0);
+  assert.equal(d.id, 101);
+});
diff --git a/web/wwwroot/rc/robot-fx.js b/web/wwwroot/rc/robot-fx.js
new file mode 100644
index 00000000..998d36dc
--- /dev/null
+++ b/web/wwwroot/rc/robot-fx.js
@@ -0,0 +1,298 @@
+// Pooled jetpack flame, POW sparks, shockwave, shield bubble and the fuel ring.
+// Everything is allocated once. update() only writes into those buffers.
+import * as T from '../vendor/three.module.js';
+
+const MAX = 96;
+
+function puffTexture() {
+  const c = document.createElement('canvas');
+  c.width = c.height = 64;
+  const g = c.getContext('2d'),
+    grad = g.createRadialGradient(32, 32, 0, 32, 32, 32);
+  grad.addColorStop(0, 'rgba(255,255,255,0.9)');
+  grad.addColorStop(0.45, 'rgba(255,255,255,0.35)');
+  grad.addColorStop(1, 'rgba(255,255,255,0)');
+  g.fillStyle = grad;
+  g.fillRect(0, 0, 64, 64);
+  return new T.CanvasTexture(c);
+}
+
+function powTexture() {
+  const c = document.createElement('canvas');
+  c.width = 128;
+  c.height = 64;
+  const g = c.getContext('2d');
+  g.font = '800 42px system-ui';
+  g.textAlign = 'center';
+  g.textBaseline = 'middle';
+  g.lineWidth = 7;
+  g.strokeStyle = '#1a1204';
+  g.fillStyle = '#ffe14a';
+  g.strokeText('POW', 64, 34);
+  g.fillText('POW', 64, 34);
+  const tex = new T.CanvasTexture(c);
+  tex.needsUpdate = true;
+  return tex;
+}
+
+function makeRing() {
+  const geo = new T.RingGeometry(0.12, 0.175, 28),
+    mat = new T.MeshBasicMaterial({
+      color: 0x5ce1ff,
+      transparent: true,
+      opacity: 0.92,
+      side: T.DoubleSide,
+      depthWrite: false
+    }),
+    mesh = new T.Mesh(geo, mat);
+  mesh.rotation.x = -Math.PI / 2;
+  mesh.frustumCulled = false;
+  mesh.renderOrder = 3;
+  mesh.visible = false;
+  return mesh;
+}
+
+export function createRobotFx(scene) {
+  const pos = new Float32Array(MAX * 3),
+    col = new Float32Array(MAX * 3),
+    life = new Float32Array(MAX),
+    span = new Float32Array(MAX),
+    vel = new Float32Array(MAX * 3),
+    size = new Float32Array(MAX),
+    base = new Float32Array(MAX),
+    alpha = new Float32Array(MAX);
+  const geo = new T.BufferGeometry();
+  geo.setAttribute('position', new T.BufferAttribute(pos, 3));
+  geo.setAttribute('color', new T.BufferAttribute(col, 3));
+  geo.setAttribute('aSize', new T.BufferAttribute(size, 1));
+  geo.setAttribute('aAlpha', new T.BufferAttribute(alpha, 1));
+  const mat = new T.ShaderMaterial({
+    uniforms: {map: {value: puffTexture()}, scale: {value: 380}},
+    transparent: true,
+    depthWrite: false,
+    vertexColors: true,
+    vertexShader:
+      'attribute float aSize;attribute float aAlpha;varying float vAlpha;varying vec3 vColor;uniform float scale;void main(){vColor=color;vAlpha=aAlpha;vec4 mv=modelViewMatrix*vec4(position,1.);gl_PointSize=aSize*scale/max(.15,-mv.z);gl_Position=projectionMatrix*mv;}',
+    fragmentShader:
+      'uniform sampler2D map;varying float vAlpha;varying vec3 vColor;void main(){float a=texture2D(map,gl_PointCoord).a*vAlpha;if(a<.02)discard;gl_FragColor=vec4(vColor,a);}'
+  });
+  const points = new T.Points(geo, mat);
+  points.frustumCulled = false;
+  points.renderOrder = 4;
+  scene.add(points);
+  let cursor = 0;
+
+  function emit(x, y, z, vx, vy, vz, r, g, b, spanS, grow) {
+    const i = cursor;
+    cursor = (cursor + 1) % MAX;
+    pos[i * 3] = x;
+    pos[i * 3 + 1] = y;
+    pos[i * 3 + 2] = z;
+    vel[i * 3] = vx;
+    vel[i * 3 + 1] = vy;
+    vel[i * 3 + 2] = vz;
+    col[i * 3] = r;
+    col[i * 3 + 1] = g;
+    col[i * 3 + 2] = b;
+    life[i] = span[i] = spanS;
+    base[i] = size[i] = grow;
+  }
+
+  const powTex = powTexture(),
+    pows = [];
+  for (let i = 0; i < 4; i++) {
+    const s = new T.Sprite(
+      new T.SpriteMaterial({map: powTex, transparent: true, depthWrite: false, opacity: 0})
+    );
+    s.visible = false;
+    s.scale.set(0.28, 0.14, 1);
+    s.userData.life = 0;
+    s.frustumCulled = false;
+    scene.add(s);
+    pows.push(s);
+  }
+  let powNext = 0;
+
+  const rings = [makeRing(), makeRing()];
+  for (const ring of rings) scene.add(ring);
+
+  const bubbles = [0, 1].map(() => {
+    const bubble = new T.Mesh(
+      new T.SphereGeometry(0.2, 16, 12),
+      new T.MeshBasicMaterial({color: 0x9ad8ff, transparent: true, opacity: 0.32, depthWrite: false})
+    );
+    bubble.visible = false;
+    bubble.frustumCulled = false;
+    scene.add(bubble);
+    return bubble;
+  });
+
+  const shocks = [0, 1].map(() => {
+    const shock = new T.Mesh(
+      new T.RingGeometry(0.28, 0.4, 28),
+      new T.MeshBasicMaterial({color: 0xffe08a, transparent: true, opacity: 0, side: T.DoubleSide, depthWrite: false})
+    );
+    shock.rotation.x = -Math.PI / 2;
+    shock.visible = false;
+    shock.frustumCulled = false;
+    shock.userData.life = 0;
+    scene.add(shock);
+    return shock;
+  });
+  let shockNext = 0;
+
+  const beams = [0, 1].map(() => {
+    const beam = new T.Mesh(
+      new T.BoxGeometry(0.025, 0.025, 1),
+      new T.MeshBasicMaterial({color: 0x8ef6ff, transparent: true, opacity: 0, depthWrite: false})
+    );
+    beam.visible = false;
+    beam.frustumCulled = false;
+    beam.userData.life = 0;
+    scene.add(beam);
+    return beam;
+  });
+  let beamNext = 0;
+  const aim = new T.Vector3();
+
+  function pop(x, y, z) {
+    const s = pows[powNext];
+    powNext = (powNext + 1) % pows.length;
+    s.position.set(x, y + 0.08, z);
+    s.material.opacity = 1;
+    s.userData.life = 0.22;
+    s.scale.set(0.2, 0.1, 1);
+    s.visible = true;
+  }
+
+  return {
+    flame(x, y, z, yaw, on) {
+      if (!on) return;
+      const bx = x - Math.sin(yaw) * 0.05,
+        bz = z + Math.cos(yaw) * 0.05,
+        jx = (Math.random() - 0.5) * 0.15,
+        jz = (Math.random() - 0.5) * 0.15;
+      emit(bx, y + 0.02, bz, jx, 0.15 + Math.random() * 0.3, jz, 1, 0.45 + Math.random() * 0.2, 0.05, 0.22, 0.08);
+      emit(bx, y + 0.03, bz, jx * 0.4, 0.35, jz * 0.4, 0.55, 0.55, 0.52, 0.4, 0.1);
+    },
+    spark(x, y, z) {
+      for (let k = 0; k < 6; k++)
+        emit(
+          x,
+          y,
+          z,
+          (Math.random() - 0.5) * 2.2,
+          0.4 + Math.random() * 1.4,
+          (Math.random() - 0.5) * 2.2,
+          1,
+          0.85,
+          0.25,
+          0.18,
+          0.06
+        );
+      pop(x, y, z);
+    },
+    dust(x, y, z) {
+      for (let k = 0; k < 8; k++)
+        emit(
+          x,
+          y + 0.02,
+          z,
+          (Math.random() - 0.5) * 1.1,
+          0.15 + Math.random() * 0.35,
+          (Math.random() - 0.5) * 1.1,
+          0.78,
+          0.72,
+          0.62,
+          0.35,
+          0.07
+        );
+    },
+    shock(x, y, z) {
+      const s = shocks[shockNext];
+      shockNext = (shockNext + 1) % shocks.length;
+      s.position.set(x, y + 0.03, z);
+      s.scale.set(0.35, 0.35, 0.35);
+      s.material.opacity = 0.85;
+      s.userData.life = 0.28;
+      s.visible = true;
+    },
+    blast(x, y, z, tx, ty, tz) {
+      const beam = beams[beamNext];
+      beamNext = (beamNext + 1) % beams.length;
+      const dx = tx - x,
+        dy = ty - y,
+        dz = tz - z,
+        len = Math.hypot(dx, dy, dz) || 0.2;
+      beam.position.set(x + dx * 0.5, y + dy * 0.5, z + dz * 0.5);
+      beam.scale.set(1, 1, len);
+      aim.set(tx, ty, tz);
+      beam.lookAt(aim);
+      beam.material.opacity = 0.95;
+      beam.userData.life = 0.08;
+      beam.visible = true;
+    },
+    fuel(i, x, y, z, amount, show) {
+      const ring = rings[i];
+      if (!ring) return;
+      ring.visible = !!show;
+      if (!show) return;
+      ring.position.set(x, y + 0.015, z);
+      const fuel = amount < 0 ? 0 : amount > 1 ? 1 : amount;
+      ring.geometry.setDrawRange(0, Math.max(6, Math.floor(fuel * ring.geometry.index.count)));
+      ring.material.color.setRGB(1 - fuel * 0.55, 0.4 + fuel * 0.5, 0.15 + fuel * 0.85);
+    },
+    bubble(i, x, y, z, show) {
+      const bubble = bubbles[i];
+      if (!bubble) return;
+      bubble.visible = !!show;
+      if (show) bubble.position.set(x, y + 0.15, z);
+    },
+    update(dt) {
+      for (let i = 0; i < MAX; i++) {
+        if (life[i] <= 0) {
+          alpha[i] = 0;
+          continue;
+        }
+        life[i] -= dt;
+        vel[i * 3 + 1] -= 1.4 * dt;
+        pos[i * 3] += vel[i * 3] * dt;
+        pos[i * 3 + 1] += vel[i * 3 + 1] * dt;
+        pos[i * 3 + 2] += vel[i * 3 + 2] * dt;
+        const age = 1 - Math.max(0, life[i]) / span[i];
+        size[i] = base[i] * (1 + age * 1.6);
+        alpha[i] = life[i] > 0 ? 0.85 * (1 - age) : 0;
+      }
+      geo.attributes.position.needsUpdate = true;
+      geo.attributes.color.needsUpdate = true;
+      geo.attributes.aSize.needsUpdate = true;
+      geo.attributes.aAlpha.needsUpdate = true;
+      for (let i = 0; i < pows.length; i++) {
+        const s = pows[i];
+        if (s.userData.life <= 0) continue;
+        s.userData.life -= dt;
+        s.material.opacity = Math.max(0, s.userData.life / 0.22);
+        const k = 0.2 + (1 - s.material.opacity) * 0.16;
+        s.scale.set(k, k * 0.5, 1);
+        if (s.userData.life <= 0) s.visible = false;
+      }
+      for (let i = 0; i < shocks.length; i++) {
+        const s = shocks[i];
+        if (s.userData.life <= 0) continue;
+        s.userData.life -= dt;
+        const u = 1 - Math.max(0, s.userData.life) / 0.28;
+        const k = 0.35 + u * 2.4;
+        s.scale.set(k, k, k);
+        s.material.opacity = s.userData.life > 0 ? 0.85 * (1 - u) : 0;
+        if (s.userData.life <= 0) s.visible = false;
+      }
+      for (let i = 0; i < beams.length; i++) {
+        const b = beams[i];
+        if (b.userData.life <= 0) continue;
+        b.userData.life -= dt;
+        b.material.opacity = b.userData.life > 0 ? b.userData.life / 0.08 : 0;
+        if (b.userData.life <= 0) b.visible = false;
+      }
+    }
+  };
+}
diff --git a/web/wwwroot/rc/robot-moves.mjs b/web/wwwroot/rc/robot-moves.mjs
new file mode 100644
index 00000000..309ff6eb
--- /dev/null
+++ b/web/wwwroot/rc/robot-moves.mjs
@@ -0,0 +1,483 @@
+// Shared robot jetpack and fighting moves. Free roam, the Robot Arena and the Jetpack FPS
+// all call stepMoves. Toy-feel numbers (fiction): a 6-year-old on an 8BitDo, not a measured
+// aircraft. No per-call allocations: timers, the hit buffer and the result live on the state.
+//
+// input (all optional, levels not edges — the state remembers the last sample):
+//   jumpHeld, punchHeld, powerHeld, shieldHeld, dashHeld, lockHeld, fireHeld, busy
+//   move: {x, z} camera-relative stick, or null when the keyboard is walking
+// robot: {pos, vel, yaw, grounded}. Targets: {id, pos, kind, body, shield}.
+// Caller applies hitBuf impulses. This module moves only the robot (jump, thrust, dash, dive).
+import {ROBOT} from './physics/robot.mjs';
+
+export const MOVES = Object.freeze({
+  // Strikes include anticipation, impact and recovery. Each one is under 300 ms.
+  jab: 0.18,
+  swing: 0.26,
+  upper: 0.24,
+  spin: 0.28,
+  dash: 0.14,
+  shield: 0.3,
+  comboWindow: 0.42,
+  dashCool: 0.32,
+  fireCool: 0.28,
+  fuelMax: 4,
+  fuelRefill: 2,
+  thrust: 18,
+  riseCap: 2.4,
+  jump: ROBOT.jump,
+  gravity: ROBOT.gravity,
+  dive: -7.4,
+  dashSpeed: 5.2,
+  lunge: 1.15,
+  knock: 2.5,
+  poundKnock: 3.6,
+  lift: 0.85,
+  hitStop: 0.05,
+  lockRange: 7,
+  hitRange: 0.5,
+  hitArc: 1.15,
+  poundRadius: 1.4,
+  blastRange: 6,
+  blastArc: 0.45,
+  blastKnock: 1.7
+});
+
+const HIT_SLOTS = 8;
+
+function blankHit() {
+  return {id: 0, kind: '', body: null, ix: 0, iy: 0, iz: 0, x: 0, y: 0, z: 0, blocked: false};
+}
+
+export function createMoves() {
+  return {
+    action: 'idle',
+    pose: 'idle',
+    poseT: 0,
+    combo: 0,
+    comboLeft: 0,
+    phase: 0,
+    dur: 0,
+    fuel: MOVES.fuelMax,
+    thrusting: false,
+    lockId: null,
+    lockPos: [0, 0, 0],
+    hitStop: 0,
+    shieldLeft: 0,
+    shieldCool: 0,
+    dashCool: 0,
+    fireCool: 0,
+    dashX: 0,
+    dashZ: 0,
+    recover: 0,
+    wasAir: false,
+    didHit: false,
+    buffered: 0,
+    bumpCool: 0,
+    prev: {punch: false, power: false, dash: false, fire: false, jump: false, shield: false},
+    hitBuf: Array.from({length: HIT_SLOTS}, blankHit),
+    out: {
+      thrust: false,
+      hitCount: 0,
+      shock: false,
+      sx: 0,
+      sy: 0,
+      sz: 0,
+      landed: false,
+      blast: false,
+      bx: 0,
+      by: 0,
+      bz: 0,
+      tx: 0,
+      ty: 0,
+      tz: 0,
+      rumble: 0,
+      frozen: false
+    }
+  };
+}
+
+/** Index of the nearest target inside range, or -1. */
+export function pickLockTarget(origin, targets, count, range = MOVES.lockRange) {
+  let best = -1,
+    bestD = range;
+  for (let i = 0; i < count; i++) {
+    const t = targets[i];
+    if (!t?.pos) continue;
+    const d = Math.hypot(t.pos[0] - origin[0], t.pos[2] - origin[2]);
+    if (d < bestD) {
+      bestD = d;
+      best = i;
+    }
+  }
+  return best;
+}
+
+function clearOut(state) {
+  const o = state.out;
+  o.thrust = false;
+  o.hitCount = 0;
+  o.shock = false;
+  o.landed = false;
+  o.blast = false;
+  o.rumble = 0;
+  o.frozen = false;
+}
+
+function begin(state, action, dur) {
+  state.action = action;
+  state.pose = action;
+  state.dur = dur;
+  state.phase = 0;
+  state.poseT = 0;
+  state.didHit = false;
+  state.buffered = 0;
+}
+
+function moving(robot, input) {
+  const m = input.move;
+  if (m && Math.hypot(m.x || 0, m.z || 0) > 0.35) return true;
+  return Math.hypot(robot.vel[0], robot.vel[2]) > 0.45;
+}
+
+function startPunch(state, robot) {
+  if (!robot.grounded) {
+    begin(state, 'pound', 0.3);
+    robot.vel[1] = Math.min(robot.vel[1], MOVES.dive);
+    state.combo = 0;
+    state.comboLeft = 0;
+    return;
+  }
+  const chain = state.combo > 0 && state.comboLeft > 0;
+  const step = chain ? state.combo + 1 : 1;
+  if (step >= 3) {
+    begin(state, 'swing', MOVES.swing);
+    state.combo = 0;
+  } else if (step === 2) {
+    begin(state, 'jab2', MOVES.jab);
+    state.combo = 2;
+  } else {
+    begin(state, 'jab', MOVES.jab);
+    state.combo = 1;
+  }
+  state.comboLeft = 0;
+}
+
+function startPower(state, robot, input) {
+  if (!robot.grounded) return;
+  if (moving(robot, input)) begin(state, 'spin', MOVES.spin);
+  else {
+    begin(state, 'upper', MOVES.upper);
+    robot.vel[1] = Math.max(robot.vel[1], 2.6);
+  }
+  state.combo = 0;
+  state.comboLeft = 0;
+}
+
+function startDash(state, robot, input) {
+  let dx = input.move?.x || 0,
+    dz = input.move?.z || 0,
+    mag = Math.hypot(dx, dz);
+  if (mag < 0.2) {
+    dx = Math.sin(robot.yaw);
+    dz = -Math.cos(robot.yaw);
+    mag = 1;
+  }
+  state.dashX = dx / mag;
+  state.dashZ = dz / mag;
+  begin(state, 'dash', MOVES.dash);
+  state.dashCool = MOVES.dashCool;
+  state.combo = 0;
+  state.comboLeft = 0;
+  robot.vel[0] = state.dashX * MOVES.dashSpeed;
+  robot.vel[2] = state.dashZ * MOVES.dashSpeed;
+}
+
+function endStrike(state) {
+  const was = state.action;
+  state.action = 'idle';
+  state.pose = 'idle';
+  state.poseT = 0;
+  if (was === 'jab' || was === 'jab2') state.comboLeft = MOVES.comboWindow;
+  else {
+    state.combo = 0;
+    state.comboLeft = 0;
+  }
+}
+
+function inArc(robot, t, range, arc) {
+  const dx = t.pos[0] - robot.pos[0],
+    dz = t.pos[2] - robot.pos[2],
+    d = Math.hypot(dx, dz);
+  if (d > range) return false;
+  const face = Math.atan2(dx, -dz),
+    diff = Math.atan2(Math.sin(face - robot.yaw), Math.cos(face - robot.yaw));
+  return Math.abs(diff) < arc;
+}
+
+function inRadius(robot, t, range) {
+  return Math.hypot(t.pos[0] - robot.pos[0], t.pos[2] - robot.pos[2]) <= range;
+}
+
+function consider(state, robot, targets, count, test, knock, lift) {
+  const buf = state.hitBuf;
+  let n = state.out.hitCount,
+    solid = false;
+  for (let i = 0; i < count; i++) {
+    const t = targets[i];
+    if (!t?.pos || !test(t)) continue;
+    if (n >= buf.length) break;
+    const h = buf[n++],
+      dx = t.pos[0] - robot.pos[0],
+      dz = t.pos[2] - robot.pos[2],
+      d = Math.hypot(dx, dz) || 1;
+    h.id = t.id;
+    h.kind = t.kind || '';
+    h.body = t.body || null;
+    h.blocked = !!t.shield;
+    h.ix = h.blocked ? 0 : (dx / d) * knock;
+    h.iy = h.blocked ? 0 : lift;
+    h.iz = h.blocked ? 0 : (dz / d) * knock;
+    h.x = t.pos[0];
+    h.y = (t.pos[1] || 0) + 0.14;
+    h.z = t.pos[2];
+    if (!h.blocked) solid = true;
+  }
+  state.out.hitCount = n;
+  return solid;
+}
+
+function lunge(robot) {
+  robot.vel[0] += Math.sin(robot.yaw) * MOVES.lunge;
+  robot.vel[2] -= Math.cos(robot.yaw) * MOVES.lunge;
+}
+
+/**
+ * One sample. Returns state.out (reused). Hits land in state.hitBuf[0..hitCount).
+ */
+export function stepMoves(state, robot, input = {}, targets = [], count = targets.length, dt = 1 / 120) {
+  const prev = state.prev,
+    punchEdge = !!input.punchHeld && !prev.punch,
+    powerEdge = !!input.powerHeld && !prev.power,
+    dashEdge = !!input.dashHeld && !prev.dash,
+    fireEdge = !!input.fireHeld && !prev.fire,
+    jumpEdge = !!input.jumpHeld && !prev.jump,
+    shieldEdge = !!input.shieldHeld && !prev.shield;
+  prev.punch = !!input.punchHeld;
+  prev.power = !!input.powerHeld;
+  prev.dash = !!input.dashHeld;
+  prev.fire = !!input.fireHeld;
+  prev.jump = !!input.jumpHeld;
+  prev.shield = !!input.shieldHeld;
+  clearOut(state);
+
+  if (state.hitStop > 0) {
+    state.hitStop -= dt;
+    if (state.hitStop < 0) state.hitStop = 0;
+    if (punchEdge) state.buffered = 1;
+    else if (powerEdge) state.buffered = 2;
+    state.out.frozen = true;
+    state.out.thrust = state.thrusting;
+    return state.out;
+  }
+
+  if (input.busy) {
+    state.thrusting = false;
+    if (robot.grounded) state.fuel = Math.min(MOVES.fuelMax, state.fuel + (MOVES.fuelMax / MOVES.fuelRefill) * dt);
+    state.wasAir = !robot.grounded;
+    state.pose = 'idle';
+    return state.out;
+  }
+
+  if (state.action === 'idle' && state.comboLeft > 0) {
+    state.comboLeft -= dt;
+    if (state.comboLeft <= 0) {
+      state.comboLeft = 0;
+      state.combo = 0;
+    }
+  }
+  state.shieldLeft = Math.max(0, state.shieldLeft - dt);
+  state.shieldCool = Math.max(0, state.shieldCool - dt);
+  state.dashCool = Math.max(0, state.dashCool - dt);
+  state.fireCool = Math.max(0, state.fireCool - dt);
+
+  const timed =
+    state.action === 'jab' ||
+    state.action === 'jab2' ||
+    state.action === 'swing' ||
+    state.action === 'upper' ||
+    state.action === 'spin' ||
+    state.action === 'dash';
+  if (timed) {
+    state.phase += dt;
+    state.poseT = state.dur > 0 ? Math.min(1, state.phase / state.dur) : 1;
+    if (!state.didHit && state.action !== 'dash') {
+      const u = state.poseT;
+      if (u >= 0.32 && u <= 0.62) {
+        state.didHit = true;
+        const solid = consider(state, robot, targets, count, t => inArc(robot, t, MOVES.hitRange, MOVES.hitArc), MOVES.knock, MOVES.lift);
+        lunge(robot);
+        if (solid) {
+          state.hitStop = MOVES.hitStop;
+          state.out.rumble = 0.75;
+        }
+      }
+    }
+    if (state.action === 'dash') {
+      robot.vel[0] = state.dashX * MOVES.dashSpeed;
+      robot.vel[2] = state.dashZ * MOVES.dashSpeed;
+    }
+    if (state.phase >= state.dur) {
+      const chain = state.buffered || (punchEdge ? 1 : powerEdge ? 2 : 0);
+      endStrike(state);
+      if (chain === 1) startPunch(state, robot);
+      else if (chain === 2) startPower(state, robot, input);
+    }
+  } else if (state.action === 'pound') {
+    state.phase += dt;
+    state.poseT = Math.min(1, state.phase / 0.22);
+    if (!robot.grounded && robot.vel[1] > MOVES.dive) robot.vel[1] = MOVES.dive;
+  }
+
+  const landed = state.wasAir && robot.grounded;
+  if (landed) {
+    state.out.landed = true;
+    if (state.action === 'pound') {
+      state.out.shock = true;
+      state.out.sx = robot.pos[0];
+      state.out.sy = robot.pos[1];
+      state.out.sz = robot.pos[2];
+      state.out.rumble = 1;
+      consider(state, robot, targets, count, t => inRadius(robot, t, MOVES.poundRadius), MOVES.poundKnock, 1.4);
+      state.hitStop = MOVES.hitStop;
+      state.action = 'idle';
+      state.combo = 0;
+      state.comboLeft = 0;
+      state.recover = 0.16;
+      state.pose = 'pound';
+      state.poseT = 1;
+    }
+  }
+
+  if (state.action === 'idle') {
+    if (punchEdge || state.buffered === 1) startPunch(state, robot);
+    else if (powerEdge || state.buffered === 2) startPower(state, robot, input);
+    else if (dashEdge && state.dashCool <= 0) startDash(state, robot, input);
+    else if (shieldEdge && state.shieldCool <= 0) {
+      state.shieldLeft = MOVES.shield;
+      state.shieldCool = MOVES.shield + 0.2;
+    }
+  }
+
+  // A tap leaves the ground. Holding A after that is the jetpack, so the hop itself spends no fuel.
+  let hopped = false;
+  if (jumpEdge && robot.grounded && state.action !== 'pound' && state.action !== 'upper') {
+    robot.vel[1] = MOVES.jump;
+    robot.grounded = false;
+    hopped = true;
+  }
+
+  const thrust =
+    !hopped && !robot.grounded && !!input.jumpHeld && state.fuel > 0 && state.action !== 'pound';
+  state.thrusting = thrust;
+  state.out.thrust = thrust;
+  if (thrust) {
+    state.fuel = Math.max(0, state.fuel - dt);
+    robot.vel[1] += MOVES.gravity * dt + 7 * dt;
+    if (robot.vel[1] > MOVES.riseCap) robot.vel[1] = MOVES.riseCap;
+    if (state.fuel <= 0) {
+      state.thrusting = false;
+      state.out.thrust = false;
+    }
+  } else if (robot.grounded) {
+    state.fuel = Math.min(MOVES.fuelMax, state.fuel + (MOVES.fuelMax / MOVES.fuelRefill) * dt);
+  }
+
+  if (input.lockHeld) {
+    const i = pickLockTarget(robot.pos, targets, count, MOVES.lockRange);
+    if (i >= 0) {
+      const t = targets[i];
+      state.lockId = t.id;
+      state.lockPos[0] = t.pos[0];
+      state.lockPos[1] = t.pos[1] || 0;
+      state.lockPos[2] = t.pos[2];
+      const face = Math.atan2(t.pos[0] - robot.pos[0], -(t.pos[2] - robot.pos[2])),
+        diff = Math.atan2(Math.sin(face - robot.yaw), Math.cos(face - robot.yaw));
+      robot.yaw += diff * Math.min(1, 12 * dt);
+    } else state.lockId = null;
+  } else state.lockId = null;
+
+  if (fireEdge && state.fireCool <= 0) {
+    state.fireCool = MOVES.fireCool;
+    const reach = MOVES.blastRange,
+      x = robot.pos[0] + Math.sin(robot.yaw) * reach,
+      z = robot.pos[2] - Math.cos(robot.yaw) * reach;
+    state.out.blast = true;
+    state.out.bx = robot.pos[0];
+    state.out.by = robot.pos[1] + 0.16;
+    state.out.bz = robot.pos[2];
+    let hit = null,
+      hitD = reach;
+    for (let i = 0; i < count; i++) {
+      const t = targets[i];
+      if (!t?.pos || !inArc(robot, t, reach, MOVES.blastArc)) continue;
+      const d = Math.hypot(t.pos[0] - robot.pos[0], t.pos[2] - robot.pos[2]);
+      if (d < hitD) {
+        hitD = d;
+        hit = t;
+      }
+    }
+    if (hit) {
+      state.out.tx = hit.pos[0];
+      state.out.ty = (hit.pos[1] || 0) + 0.14;
+      state.out.tz = hit.pos[2];
+      consider(state, robot, targets, count, t => t === hit, MOVES.blastKnock, 0.4);
+    } else {
+      state.out.tx = x;
+      state.out.ty = robot.pos[1] + 0.16;
+      state.out.tz = z;
+    }
+  }
+
+  if (state.action === 'idle') {
+    if (state.recover > 0) {
+      state.recover -= dt;
+      state.pose = 'pound';
+      state.poseT = Math.max(0, state.recover / 0.16);
+    } else if (state.shieldLeft > 0) {
+      state.pose = 'shield';
+      state.poseT = 1 - state.shieldLeft / MOVES.shield;
+    } else if (thrust) {
+      state.pose = 'fly';
+      state.poseT = 1;
+    } else {
+      state.pose = 'idle';
+      state.poseT = 0;
+    }
+  }
+
+  state.wasAir = !robot.grounded;
+  return state.out;
+}
+
+/** Soft body bump. Pushes every call; the spark is once per contact. No damage. */
+export function bumpRobots(a, b, dt = 1 / 120) {
+  if (a?.moves) a.moves.bumpCool = Math.max(0, a.moves.bumpCool - dt);
+  if (!a?.pos || !b?.pos) return false;
+  const dx = b.pos[0] - a.pos[0],
+    dz = b.pos[2] - a.pos[2],
+    d = Math.hypot(dx, dz),
+    min = 0.22;
+  if (d >= min || d < 1e-4) return false;
+  const nx = dx / d,
+    nz = dz / d,
+    push = (min - d) * 14,
+    as = a.moves?.shieldLeft > 0 ? 0.25 : 1,
+    bs = b.moves?.shieldLeft > 0 ? 0.25 : 1;
+  a.vel[0] -= nx * push * as;
+  a.vel[2] -= nz * push * as;
+  b.vel[0] += nx * push * bs;
+  b.vel[2] += nz * push * bs;
+  if (a.moves && a.moves.bumpCool > 0) return false;
+  if (a.moves) a.moves.bumpCool = 0.28;
+  return true;
+}
