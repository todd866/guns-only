 import test from 'node:test';
 import assert from 'node:assert/strict';
-import {splitScreenOn, toggleP2SkateForm, p2RobotPad, flightGamepadInput, rivalHumanInput} from './split-p2.mjs';
+import {readFileSync} from 'node:fs';
+import {splitScreenOn, toggleP2SkateForm, p2RobotPad, flightGamepadInput, rivalHumanInput, screenHeld, overlayAnchor} from './split-p2.mjs';
 
 test('split stays on while either player is a robot', () => {
   const base = {split: {pad: 1}, rival: {}, started: true, p1Robot: false, p2Robot: false};
@@ -100,3 +101,38 @@ test('rivalHumanInput holds the car while player 2 is the robot', () => {
   assert.equal(out.boardSpin, false);
   assert.equal(out.flight, undefined);
 });
+
+test('a pause, brief, map or leave row stops player 2 as well as player 1', () => {
+  const driving = {
+    paused: false,
+    uiPanel: false,
+    pad2: {throttle: 1, steer: 0.2, brake: false, drift: false},
+    gp: null,
+    mode: 'kid',
+    session: {flight: {mode: null}},
+    fire: false,
+    tagBoost: 1,
+    p2Form: 'car'
+  };
+  assert.equal(rivalHumanInput(driving).throttle, 1);
+  for (const flag of ['paused', 'uiPanel', 'held']) {
+    const out = rivalHumanInput({...driving, [flag]: true});
+    assert.equal(out.throttle, 0, flag);
+    assert.equal(out.brake, true, flag);
+  }
+  assert.equal(screenHeld({brief: true}), true);
+  assert.equal(screenHeld({panel: 'map'}), true);
+  assert.equal(screenHeld({dialog: true}), true);
+  assert.equal(screenHeld({leave: true}), true);
+  assert.equal(screenHeld({}), false);
+});
+
+test('split pause and map sit on the full screen centre', () => {
+  const box = overlayAnchor(1920, 640);
+  assert.equal(box.center, 960);
+  assert.ok(box.left > 500, 'not pinned to the left half');
+  const css = readFileSync(new URL('./style.css', import.meta.url), 'utf8');
+  assert.match(css, /body\.split :is\(#brief,#result,\.overlay,#tag-result,#hunt-result,dialog\.rc-race-menu\)\{[^}]*position:fixed/);
+  assert.match(css, /body\.split :is\(#brief,#result,\.overlay,#tag-result,#hunt-result,dialog\.rc-race-menu\)\{[^}]*left:50%/);
+  assert.match(css, /body\.split :is\(#brief,#result,\.overlay,#tag-result,#hunt-result,dialog\.rc-race-menu\)\{[^}]*translate\(-50%,-50%\)/);
+});
