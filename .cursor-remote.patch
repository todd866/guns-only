+} from './robot-arena.mjs';
+
+const $ = id => (typeof document === 'undefined' ? null : document.getElementById(id));
+
+function sign(text) {
+  const c = document.createElement('canvas');
+  c.width = 1024;
+  c.height = 192;
+  const g = c.getContext('2d');
+  g.fillStyle = '#1b1218';
+  g.fillRect(0, 0, 1024, 192);
+  g.fillStyle = '#ff4d6a';
+  g.fillRect(0, 0, 1024, 14);
+  g.fillRect(0, 178, 1024, 14);
+  g.fillStyle = '#fff6ea';
+  g.font = '700 92px system-ui';
+  g.textAlign = 'center';
+  g.fillText(text, 512, 128, 980);
+  const map = new T.CanvasTexture(c);
+  map.colorSpace = T.SRGBColorSpace;
+  const mesh = new T.Mesh(
+    new T.PlaneGeometry(6.4, 1.2),
+    new T.MeshBasicMaterial({map, side: T.DoubleSide})
+  );
+  mesh.name = 'RobotArenaSign';
+  return mesh;
+}
+
+export function createRobotArena(scene, world, {heightAt} = {}) {
+  const floor = heightAt ? heightAt(ARENA.center[0], ARENA.center[2]) : 0;
+  const root = new T.Group();
+  root.name = 'RobotArena';
+  root.position.set(ARENA.center[0], floor, ARENA.center[2]);
+  scene.add(root);
+
+  const domeMat = new T.MeshStandardMaterial({
+    color: '#ff4d6a',
+    emissive: '#ff2d55',
+    emissiveIntensity: 0.85,
+    roughness: 0.25,
+    metalness: 0.05,
+    transparent: true,
+    opacity: 0.28,
+    side: T.DoubleSide,
+    depthWrite: false
+  });
+  const dome = new T.Mesh(new T.SphereGeometry(ARENA.outer, 28, 16, 0, Math.PI * 2, 0, Math.PI / 2), domeMat);
+  dome.position.y = 0.05;
+  dome.name = 'RobotArenaDome';
+  root.add(dome);
+
+  const deck = new T.Mesh(
+    new T.CircleGeometry(ARENA.radius + 0.35, 32),
+    new T.MeshStandardMaterial({color: '#241820', roughness: 0.85, metalness: 0.05})
+  );
+  deck.rotation.x = -Math.PI / 2;
+  deck.position.y = 0.03;
+  root.add(deck);
+
+  const ring = new T.Mesh(
+    new T.TorusGeometry(ARENA.radius, 0.06, 8, 40),
+    new T.MeshStandardMaterial({
+      color: '#7cf6ff',
+      emissive: '#3ee0ff',
+      emissiveIntensity: 1.4,
+      roughness: 0.2
+    })
+  );
+  ring.rotation.x = Math.PI / 2;
+  ring.position.y = 0.55;
+  root.add(ring);
+
+  const rope = new T.Mesh(
+    new T.TorusGeometry(ARENA.radius, 0.045, 8, 40),
+    ring.material
+  );
+  rope.rotation.x = Math.PI / 2;
+  rope.position.y = 1.05;
+  root.add(rope);
+
+  const board = sign('ROBOT ARENA');
+  board.position.set(0, 2.35, ARENA.outer - 0.15);
+  root.add(board);
+
+  const postMat = new T.MeshStandardMaterial({
+    color: '#d7fbff',
+    emissive: '#8ef6ff',
+    emissiveIntensity: 0.7,
+    roughness: 0.35
+  });
+  for (let i = 0; i < 18; i++) {
+    const a = (i / 18) * Math.PI * 2;
+    const lx = Math.sin(a) * ARENA.outer * 0.96;
+    const lz = Math.cos(a) * ARENA.outer * 0.96;
+    const gate = lz > ARENA.outer - 2.4 && Math.abs(lx) < 2.5;
+    if (!gate) {
+      addBox(world, ARENA.center[0] + lx, ARENA.center[2] + lz, 1.05, 1.05, floor, floor + 1.45);
+      const post = new T.Mesh(new T.CylinderGeometry(0.12, 0.16, 2.4, 8), postMat);
+      post.position.set(lx, 1.2, lz);
+      root.add(post);
+    }
+  }
+  for (const side of [-1.7, 1.7]) {
+    const jamb = new T.Mesh(new T.BoxGeometry(0.28, 2.6, 0.28), postMat);
+    jamb.position.set(side, 1.3, ARENA.outer - 0.2);
+    root.add(jamb);
+  }
+
+  const padMat = new T.MeshStandardMaterial({color: '#3a4550', roughness: 0.6, metalness: 0.2});
+  for (const p of ARENA.platforms) {
+    const box = new T.Mesh(new T.BoxGeometry(p.w, 0.12, p.w), padMat);
+    box.position.set(p.x, p.y, p.z);
+    root.add(box);
+  }
