--- /dev/null
+++ b/web/wwwroot/rc/chase-camera.test.mjs
@@ -0,0 +1,26 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {pullChaseCamera} from './chase-camera.mjs';
+
+// Wall at z = -0.2, outward normal +z, so a ray from the car (z = 0) looking
+// back (negative z) hits it. The wanted camera is 1.5 m behind the car.
+const wall = (origin, dir, max) => {
+  if (dir[2] >= -1e-6 || origin[2] <= -0.2) return null;
+  const dist = (origin[2] - -0.2) / -dir[2];
+  if (dist < 0 || dist > max) return null;
+  return {dist};
+};
+
+test('a close wall pulls the camera off the texture instead of parking on it', () => {
+  const eye = [0, 0.5, 0];
+  const want = [0, 0.55, -1.5];
+  const got = pullChaseCamera(eye, want, wall);
+  assert.ok(got[2] > -0.2, `camera stays on the car side of the wall (z ${got[2]})`);
+  assert.ok(-0.2 - got[2] > 0.15 || got[1] > eye[1] + 0.4, 'clearance or a lift, not 5 cm of texture');
+  assert.ok(got[1] > 0.9, `lifts off the face (y ${got[1]})`);
+});
+
+test('open air leaves the chase camera where it was asked', () => {
+  const want = [1, 2, 3];
+  assert.deepEqual(pullChaseCamera([0, 0.5, 0], want, () => null), want);
+});
