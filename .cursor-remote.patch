diff --git a/web/wwwroot/rc/robot-arena.test.mjs b/web/wwwroot/rc/robot-arena.test.mjs
new file mode 100644
index 00000000..83782825
--- /dev/null
+++ b/web/wwwroot/rc/robot-arena.test.mjs
@@ -0,0 +1,278 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {mapPad} from './gamepad.mjs';
+import {padSvg} from './pad-art.mjs';
+import {insideBase} from './open-world/boundary.mjs';
+import {loadProgress, locationById, saveProgress} from './open-world/catalog.mjs';
+import {
+  ARENA,
+  ARENA_PAINT,
+  CPU,
+  CPU_BOUNDS,
+  OPPONENTS,
+  chooseMode,
+  coloursFor,
+  cpuDecision,
+  cpuWithinBounds,
+  createArena,
+  cycleColour,
+  extraPaints,
+  grantArenaTrophy,
+  inArenaGate,
+  leaveArena,
+  modeIds,
+  rematch,
+  setRoundTimer,
+  stepArena
+} from './open-world/robot-arena.mjs';
+
+const buttons = (down = []) => Array.from({length: 17}, (_, i) => ({value: down.includes(i) ? 1 : 0}));
+const pad = down => ({axes: [0, 0, 0, 0], buttons: buttons(down)});
+
+function toFight(st) {
+  let n = 0;
+  while (st.phase !== 'fight' && n++ < 80) stepArena(st, [], 0.05);
+  assert.equal(st.phase, 'fight');
+}
+
+function winRound(st, side = 1) {
+  toFight(st);
+  for (const f of st.fighters) if (f.side === side) f.hp = 0;
+  const ev = stepArena(st, [], 1 / 60);
+  assert.equal(st.phase, 'ko');
+  assert.equal(ev.cue, 'K.O.!');
+  assert.ok(st.fighters.some(f => f.side === side && f.parts.length === 6));
+  assert.ok(st.fighters.some(f => f.side === 1 - side && f.pose === 'victory'));
+  stepArena(st, [], ARENA.koTime + 0.05);
+}
+
+test('Robot Arena is a hub place inside the base, with a gate you drive into', () => {
+  const p = locationById('robot-arena');
+  assert.equal(p.name, 'Robot Arena');
+  assert.equal(p.short, 'Robot Arena');
+  assert.equal(p.game, 'robot-arena');
+  assert.ok(insideBase(p.pos[0], p.pos[2]));
+  assert.ok(insideBase(ARENA.center[0], ARENA.center[2]));
+  assert.ok(inArenaGate(p.pos));
+  assert.equal(inArenaGate(ARENA.exit), false);
+  assert.ok(Math.hypot(ARENA.exit[0] - ARENA.gate[0], ARENA.exit[2] - ARENA.gate[2]) > ARENA.gateReach);
+});
+
+test('1 player can only pick the CPU ladder; 2 players also get versus and co-op', () => {
+  const one = createArena({players: 1});
+  assert.deepEqual(modeIds(one.players), ['ladder']);
+  assert.equal(chooseMode(one, 'versus'), false);
+  assert.equal(chooseMode(one, 'coop'), false);
+  assert.equal(one.phase, 'menu');
+  assert.equal(chooseMode(one, 'ladder'), true);
+  assert.equal(one.phase, 'intro');
+  assert.equal(one.banner, 'ROUND 1');
+  assert.equal(one.fighters.filter(f => f.cpu).length, 1);
+  assert.equal(one.fighters.length, 2);
+
+  const two = createArena({players: 2});
+  assert.deepEqual(modeIds(two.players), ['ladder', 'versus', 'coop']);
+  assert.equal(chooseMode(two, 'versus'), true);
+  assert.equal(two.fighters.some(f => f.cpu), false);
+  assert.deepEqual(
+    two.fighters.map(f => f.id),
+    ['p1', 'p2']
+  );
+  const coop = createArena({players: 2});
+  chooseMode(coop, 'coop');
+  assert.equal(coop.fighters.length, 3);
+  assert.equal(coop.fighters.filter(f => f.side === 0).length, 2);
+  assert.equal(coop.fighters.filter(f => f.cpu).length, 1);
+});
+
+test('a match is best of 3, then the ladder advances, and clearing it unlocks the paint', () => {
+  const st = createArena();
+  chooseMode(st, 'ladder');
+  assert.equal(st.fighters.find(f => f.cpu).id, OPPONENTS[0].id);
+  winRound(st);
+  assert.equal(st.round, 2);
+  assert.equal(st.scores[0], 1);
+  assert.equal(st.phase, 'intro');
+  assert.equal(st.banner, 'ROUND 2');
+  winRound(st);
+  assert.equal(st.ladder, 1);
+  assert.equal(st.round, 1);
+  assert.equal(st.scores[0], 0);
+  assert.equal(st.fighters.find(f => f.cpu).id, 'bolt');
+  winRound(st);
+  winRound(st);
+  assert.equal(st.ladder, 2);
+  assert.equal(st.fighters.find(f => f.cpu).name, 'Titan');
+  winRound(st);
+  winRound(st);
+  assert.equal(st.phase, 'trophy');
+  assert.equal(st.trophy, true);
+  assert.equal(st.banner, 'CHAMPION!');
+  const progress = loadProgress({getItem: () => null});
+  assert.equal(extraPaints(progress).length, 0);
+  const paint = grantArenaTrophy(progress);
+  assert.equal(paint, ARENA_PAINT);
+  assert.equal(grantArenaTrophy(progress), null);
+  const storage = {saved: null, getItem: () => storage.saved, setItem: (_k, v) => (storage.saved = v)};
+  saveProgress(storage, progress);
+  const loaded = loadProgress(storage);
+  assert.equal(loaded.arenaTrophy, true);
+  assert.equal(loaded.paint, progress.paint);
+  loaded.paint = ARENA_PAINT.color;
+  saveProgress(storage, loaded);
+  assert.equal(loadProgress(storage).paint, ARENA_PAINT.color);
+  const locked = loadProgress({getItem: () => JSON.stringify({paint: ARENA_PAINT.color, arenaTrophy: false})});
+  assert.equal(locked.arenaTrophy, false);
+  assert.notEqual(locked.paint, ARENA_PAINT.color);
+});
+
+test('versus does not unlock the paint, and a loss does not advance the ladder', () => {
+  const vs = createArena({players: 2});
+  chooseMode(vs, 'versus');
+  winRound(vs);
+  winRound(vs);
+  assert.equal(vs.phase, 'match');
+  assert.equal(vs.trophy, false);
+  const progress = loadProgress({getItem: () => null});
+  assert.equal(extraPaints(progress).length, 0);
+
+  const st = createArena();
+  chooseMode(st, 'ladder');
+  toFight(st);
+  st.fighters.find(f => f.id === 'p1').hp = 0;
+  stepArena(st, [], 1 / 60);
+  stepArena(st, [], ARENA.koTime + 0.05);
+  assert.equal(st.scores[1], 1);
+  assert.equal(st.ladder, 0);
+  assert.equal(st.round, 2);
+});
+
+test('CPU tiers stay inside the kid bounds and never combo into a K.O.', () => {
+  for (const tier of ['easy', 'medium']) {
+    assert.equal(cpuWithinBounds(tier), true, tier);
+    const spec = CPU[tier];
+    assert.ok(spec.telegraph >= CPU_BOUNDS.telegraphMin);
+    assert.ok(spec.block <= CPU_BOUNDS.blockMax);
+    assert.ok(spec.damage * spec.comboMax < ARENA.health);
+  }
+  const easy = CPU.easy,
+    medium = CPU.medium;
+  assert.deepEqual(
+    cpuDecision(medium, {dist: 0.4, foePose: 'idle', foeHp: medium.damage, combo: 1, random: 0.9, windup: 0}),
+    {back: true}
+  );
+  assert.equal(
+    cpuDecision(medium, {dist: 0.4, foePose: 'idle', foeHp: medium.damage, combo: 0, random: 0.9, windup: 0}).windup,
+    true
+  );
+  assert.deepEqual(
+    cpuDecision(easy, {dist: 0.4, foePose: 'idle', foeHp: 80, combo: 1, random: 0.9, windup: 0}),
+    {back: true}
+  );
+  assert.equal(
+    cpuDecision(medium, {dist: 0.4, foePose: 'punch', foeHp: 90, combo: 0, random: 0, windup: 0}).shield,
+    true
+  );
+  assert.equal(
+    cpuDecision(medium, {dist: 0.4, foePose: 'punch', foeHp: 90, combo: 0, random: 0.99, windup: 0}).shield,
+    undefined
+  );
+
+  const st = createArena({random: () => 0.5});
+  chooseMode(st, 'ladder');
+  toFight(st);
+  const cpu = st.fighters.find(f => f.cpu);
+  const p1 = st.fighters.find(f => f.id === 'p1');
+  p1.x = cpu.x;
+  p1.z = cpu.z + 0.45;
+  const seen = [];
+  for (let t = 0; t < 10; t += 1 / 60) {
+    if (st.phase !== 'fight') break;
+    const ev = stepArena(st, [{x: 0, z: 0}], 1 / 60);
+    for (const h of ev.hits) if (h.id === 'p1') seen.push(h);
+  }
+  for (let i = 1; i < seen.length; i++) {
+    if (seen[i].ko) assert.ok(seen[i].t - seen[i - 1].t > 0.5, 'the K.O. is not the second hit of a combo');
+  }
+  assert.ok(seen.length === 0 || seen[0].t >= easy.telegraph - 0.08, 'the first swing is telegraphed');
+});
+
+test('the ropes bounce a fighter back inside, and a shield stops a punch from the front', () => {
+  const st = createArena({players: 2});
+  chooseMode(st, 'versus');
+  toFight(st);
+  const p1 = st.fighters.find(f => f.id === 'p1');
+  p1.x = ARENA.radius + 1;
+  p1.z = 0;
+  p1.vx = 4;
+  stepArena(st, [{x: 1, z: 0}, {}], 1 / 30);
+  assert.ok(Math.hypot(p1.x, p1.z) <= ARENA.radius + 1e-6);
+
+  const shield = createArena({players: 2});
+  chooseMode(shield, 'versus');
+  toFight(shield);
+  const a = shield.fighters.find(f => f.id === 'p1');
+  const b = shield.fighters.find(f => f.id === 'p2');
+  a.x = 0;
+  a.z = 0.3;
+  a.yaw = Math.PI;
+  b.x = 0;
+  b.z = -0.05;
+  b.yaw = 0;
+  const ev = stepArena(shield, [{shield: true}, {punch: true}], 1 / 60);
+  assert.equal(a.hp, ARENA.health);
+  assert.equal(ev.hits.length, 0);
+});
+
+test('round timer stays off unless asked, rematch stays in the arena, leave returns to the gate', () => {
+  const st = createArena();
+  chooseMode(st, 'ladder');
+  assert.equal(st.timerOn, false);
+  assert.equal(st.clock, null);
+  toFight(st);
+  stepArena(st, [], 30);
+  assert.equal(st.phase, 'fight');
+  setRoundTimer(st, true);
+  assert.equal(st.clock, 60);
+  st.fighters.find(f => f.cpu).hp = 40;
+  st.clock = 0.02;
+  stepArena(st, [], 0.05);
+  assert.equal(st.phase, 'ko');
+  assert.equal(st.winnerSide, 0);
+
+  const again = createArena();
+  chooseMode(again, 'ladder');
+  winRound(again);
+  assert.equal(rematch(again), true);
+  assert.equal(again.round, 1);
+  assert.deepEqual(again.scores, [0, 0]);
+  assert.equal(again.phase, 'intro');
+  assert.notEqual(again.phase, 'off');
+  const at = leaveArena(again);
+  assert.equal(again.phase, 'off');
+  assert.deepEqual(at.pos, [...ARENA.exit]);
+  assert.equal(rematch(again), false);
+});
+
+test('fighter colour cycles, and Champion appears only with the trophy', () => {
+  const st = createArena({colour: '#ed9145'});
+  assert.equal(coloursFor(st).some(c => c.color === ARENA_PAINT.color), false);
+  const next = cycleColour(st);
+  assert.notEqual(next.color, '#ed9145');
+  assert.equal(st.colour, next.color);
+  st.trophy = true;
+  assert.equal(coloursFor(st).at(-1).name, 'Champion');
+  while (st.colour !== ARENA_PAINT.color) cycleColour(st);
+  assert.equal(st.colour, ARENA_PAINT.color);
+});
+
+test('the coach shows the arena moves on the same pad', () => {
+  const foot = mapPad('arena', pad([2, 3, 4, 5]));
+  assert.equal(foot.punch, true);
+  assert.equal(foot.boostHeld, true);
+  assert.equal(foot.shield, true);
+  assert.equal(foot.dash, true);
+  const art = padSvg('xbox', {pressed: new Set(), axes: [0, 0, 0, 0]}, {form: 'arena'});
+  for (const word of ['JET', 'PUNCH', 'POWER', 'SHIELD', 'DASH', 'LOCK', 'BLAST'])
+    assert.match(art, new RegExp(word));
+});
