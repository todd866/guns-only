<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Separate outputs prevent native tests and the browser from reusing differently packed
       assemblies when built consecutively in the same checkout. -->
  <PropertyGroup Condition="'$(EmbedOkanaganTruth)' == 'false'">
    <IntermediateOutputPath>obj/$(Configuration)/deferred/</IntermediateOutputPath>
    <OutputPath>bin/$(Configuration)/deferred/</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="../web/wwwroot/content/packs/okanagan-fire/environment/okanagan-resorts.osm.json"
                      Condition="'$(EmbedOkanaganTruth)' != 'false'"
                      LogicalName="GunsOnly.Sim.Data.OkanaganResorts.osm.json" />
    <!-- Rapier v2 has one geometry authority. The canonical authored shape and its deterministic
         derived engineering artifact are embedded so runtime physics cannot drift onto a second
         hand-maintained set of dimensions, masses, inertias, inlet area, or thermal limits. -->
    <EmbeddedResource Include="../airframes/rapier.v2.json"
                      Link="Airframes/rapier.v2.json"
                      LogicalName="GunsOnly.Sim.Airframes.rapier.v2.json" />
    <EmbeddedResource Include="../airframes/generated/rapier.v2.engineering.json"
                      Link="Airframes/rapier.v2.engineering.json"
                      LogicalName="GunsOnly.Sim.Airframes.rapier.v2.engineering.json" />
    <!-- The Fire Boss simulation and browser render the same committed CDEM samples. Native tools embed the
         browser pack; WASM installs the same hash-verified bytes on the Fire Boss page. -->
    <EmbeddedResource Include="../web/wwwroot/content/packs/okanagan-fire/environment/okanagan-central.cdem.json"
                      Link="Okanagan/okanagan-central.cdem.json"
                      Condition="'$(EmbedOkanaganTruth)' != 'false'"
                      LogicalName="GunsOnly.Sim.Data.OkanaganCentral.cdem.json" />
    <EmbeddedResource Include="../web/wwwroot/content/packs/okanagan-fire/environment/okanagan-central.world.json"
                      Link="Okanagan/okanagan-central.world.json"
                      Condition="'$(EmbedOkanaganTruth)' != 'false'"
                      LogicalName="GunsOnly.Sim.Data.OkanaganCentral.world.json" />
  </ItemGroup>

</Project>
