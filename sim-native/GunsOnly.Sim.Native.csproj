<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework Condition="'$(RuntimeIdentifier)' != 'ios-arm64'">net8.0</TargetFramework>
    <TargetFramework Condition="'$(RuntimeIdentifier)' == 'ios-arm64'">net10.0</TargetFramework>
    <AssemblyName>GunsOnlySim</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
    <PublishAotUsingRuntimePack Condition="'$(RuntimeIdentifier)' == 'ios-arm64'">true</PublishAotUsingRuntimePack>
    <SelfContained Condition="'$(RuntimeIdentifier)' == 'ios-arm64'">true</SelfContained>
    <InvariantGlobalization>true</InvariantGlobalization>
    <OptimizationPreference>Speed</OptimizationPreference>
    <NativeLib Condition="'$(RuntimeIdentifier)' != 'ios-arm64'">Shared</NativeLib>
    <NativeLib Condition="'$(RuntimeIdentifier)' == 'ios-arm64'">Static</NativeLib>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../sim/GunsOnly.Sim.csproj" />
    <Compile Include="../web/KoreaTerrainTruth.cs" Link="KoreaTerrainTruth.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="../content/packs/ukraine-modern/environment/terrain-atlas/rapier-site.kernel.truth"
                      LogicalName="GunsOnly.Web.Data.UkraineRapierSite.truth" />
    <EmbeddedResource Include="../content/packs/ukraine-modern/environment/terrain-atlas/rapier-range.kernel.truth"
                      LogicalName="GunsOnly.Web.Data.UkraineRapierRange.truth" />
  </ItemGroup>

</Project>
